<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MasterDocumentation</RootNamespace>
    <AssemblyName>MasterDocumentation</AssemblyName>
    <Version>1.2.0-beta</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Все библиотеки упакованы в сам EXE: иначе рядом с ним лежат сотни файлов и найти
         MasterDocumentation.exe в папке трудно. Фиксированный WebView2 Runtime и файлы
         редактора остаются отдельными папками — они подключаются как обычные файлы. -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="WebView2.Runtime.X64" Version="150.0.4078.65" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="..\MasterDocumentation.Core\MasterDocumentation.Core.csproj"/><ProjectReference Include="..\MasterDocumentation.Infrastructure\MasterDocumentation.Infrastructure.csproj"/><ProjectReference Include="..\MasterDocumentation.Backup\MasterDocumentation.Backup.csproj"/><ProjectReference Include="..\MasterDocumentation.Export\MasterDocumentation.Export.csproj"/><ProjectReference Include="..\MasterDocumentation.Editor\MasterDocumentation.Editor.csproj"/></ItemGroup>
  <ItemGroup><Content Include="..\MasterDocumentation.Editor\web\dist\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><TargetPath>Editor\%(RecursiveDir)%(Filename)%(Extension)</TargetPath></Content></ItemGroup>
</Project>
