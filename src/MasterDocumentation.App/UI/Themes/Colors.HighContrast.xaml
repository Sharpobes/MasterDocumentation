<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Background/App" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Background/Sidebar" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Background/Surface" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Background/SurfaceElevated" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="Background/Hover" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Background/Pressed" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Background/Selected" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Background/Editor" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Background/Overlay" Color="#CC000000"/>
    <SolidColorBrush x:Key="Border/Subtle" Color="{x:Static SystemColors.ActiveBorderColor}"/>
    <SolidColorBrush x:Key="Border/Default" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Border/Strong" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Border/Focus" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Text/Primary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Text/Secondary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Text/Muted" Color="{x:Static SystemColors.GrayTextColor}"/>
    <SolidColorBrush x:Key="Text/Disabled" Color="{x:Static SystemColors.GrayTextColor}"/>
    <SolidColorBrush x:Key="Text/OnAccent" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="Text/Link" Color="{x:Static SystemColors.HotTrackColor}"/>
    <SolidColorBrush x:Key="Accent/Primary" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Accent/Hover" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Accent/Pressed" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Accent/Soft" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="State/Success" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="State/SuccessSoft" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="State/Warning" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="State/WarningSoft" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="State/Error" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="State/ErrorSoft" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="State/Info" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="State/InfoSoft" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="WindowBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="ElevatedPanelBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{x:Static SystemColors.GrayTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="SoftAccentBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
</ResourceDictionary>
