<Window x:Class="MasterDocumentation.Views.ListFormatDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Параметры списка" Width="440" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindowStyle}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Параметры списка" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Выберите вид маркеров и начальное значение нумерации." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,18"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="58"/></Grid.RowDefinitions>
   <TextBlock Text="Тип списка" VerticalAlignment="Center"/><ComboBox x:Name="KindBox" Grid.Column="1" SelectionChanged="Kind_Changed"><ComboBoxItem Content="Нумерованный" Tag="ordered"/><ComboBoxItem Content="Маркированный" Tag="bullet"/></ComboBox>
   <TextBlock Grid.Row="1" Text="Вид нумерации" VerticalAlignment="Center"/><ComboBox x:Name="StyleBox" Grid.Row="1" Grid.Column="1"/>
   <TextBlock Grid.Row="2" Text="Начать с" VerticalAlignment="Center"/><TextBox x:Name="StartBox" Grid.Row="2" Grid.Column="1" Text="1"/>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Отмена" IsCancel="True"/><Button Content="Применить" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click"/></StackPanel>
 </Grid>
</Window>
