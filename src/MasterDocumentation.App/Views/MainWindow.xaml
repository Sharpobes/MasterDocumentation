<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MasterDocumentation.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:MasterDocumentation.Models;assembly=MasterDocumentation.Core" xmlns:editor="clr-namespace:MasterDocumentation.Editor;assembly=MasterDocumentation.Editor" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:MasterDocumentation.Views" xmlns:ui="clr-namespace:MasterDocumentation.UI" Title="MasterDocumentation" Width="1536" Height="1024" MinWidth="900" MinHeight="640" Style="{x:Null}" WindowStyle="None" Background="{DynamicResource Background/App}" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
    <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
  </Window.CommandBindings>
  <Window.Resources>
    <HierarchicalDataTemplate x:Key="OutlineTemplate" ItemsSource="{Binding Children}">
      <Border x:Name="OutlineSurface" Background="Transparent" CornerRadius="{StaticResource Radius.Small}" Padding="5,4">
        <TextBlock x:Name="OutlineText" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
      </Border>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="OutlineSurface" Property="Background" Value="{DynamicResource Accent/Soft}" />
          <Setter TargetName="OutlineText" Property="Foreground" Value="{DynamicResource Text/Primary}" />
          <Setter TargetName="OutlineText" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>
    <Grid x:Name="OperationOverlay" Grid.RowSpan="3" Panel.ZIndex="90" Visibility="Collapsed" Background="{DynamicResource Background/Overlay}">
      <Border Width="430" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Strong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Large}">
        <StackPanel>
          <TextBlock x:Name="OperationTitle" Style="{StaticResource Typography.SectionTitle}" Text="Выполняется операция" />
          <TextBlock x:Name="OperationDescription" Margin="0,7,0,16" Foreground="{DynamicResource Text/Secondary}" Text="Пожалуйста, не закрывайте приложение." TextWrapping="Wrap" />
          <ProgressBar Height="6" IsIndeterminate="True" AutomationProperties.Name="Выполнение операции" />
        </StackPanel>
      </Border>
    </Grid>
    <!-- Верхняя строка приложения -->
    <Border Grid.Row="0" Background="{DynamicResource Background/App}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="BrandColumn" Width="260" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource Accent/Primary}">
            <ui:AppIcon Kind="App" Width="14" Height="14" Foreground="{DynamicResource Text/OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MasterDocumentation" Foreground="{DynamicResource Text/Primary}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
          <Border x:Name="PreReleaseBadge" Visibility="Collapsed" Margin="0,0,10,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource State/WarningSoft}" BorderBrush="{DynamicResource State/Warning}" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock x:Name="PreReleaseBadgeText" Text="BETA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource State/Warning}" />
          </Border>
          <Button x:Name="AppMenuButton" Style="{StaticResource IconButton}" Content="☰" FontSize="15" ToolTip="Меню приложения" Click="AppMenu_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Создать документ" InputGestureText="Ctrl+N" Click="NewDocument_Click" />
                <MenuItem Header="Создать папку" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click" />
                <Separator />
                <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Command="ApplicationCommands.Save" />
                <MenuItem Header="Резервная копия" Click="Backup_Click" />
                <MenuItem Header="Восстановить" Click="Restore_Click" />
                <MenuItem Header="Экспорт" InputGestureText="Ctrl+Shift+S" Click="Export_Click" />
                <MenuItem Header="Открытые вкладки" Click="TabsOverflow_Click" />
                <MenuItem Header="База данных: импорт и выгрузка…" Click="DatabaseTransfer_Click" />
                <Separator />
                <MenuItem x:Name="LibraryPanelMenuItem" Header="Показывать библиотеку" IsCheckable="True" IsChecked="True" Click="ToggleLibraryPanel_Click" />
                <MenuItem x:Name="StructurePanelMenuItem" Header="Показывать структуру" IsCheckable="True" IsChecked="True" Click="ToggleStructurePanel_Click" />
                <MenuItem x:Name="PropertiesPanelMenuItem" Header="Показывать свойства" IsCheckable="True" IsChecked="True" Click="TogglePropertiesPanel_Click" />
                <MenuItem Header="Режим фокусировки" InputGestureText="Ctrl+Shift+F" Click="FocusMode_Click" />
                <Separator />
                <MenuItem Header="Тёмная тема" IsCheckable="True" IsChecked="{Binding DarkTheme}" />
                <MenuItem Header="Проверить обновления" Click="CheckUpdates_Click" />
                <MenuItem Header="Страница загрузок" Click="Downloads_Click" />
                <MenuItem Header="О программе" Click="About_Click" />
                <MenuItem Header="Выход" InputGestureText="Alt+F4" Click="Exit_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <!-- Полоса прокрутки отключена: она забирает высоту у строки заголовка и обрезает вкладки,
             а весь список открытых документов доступен по кнопке переполнения справа. -->
        <ListBox x:Name="Tabs" Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab,Mode=TwoWay}" SelectionChanged="Tabs_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <ListBox.ItemContainerStyle>
            <!-- Контейнер не рисует собственную рамку: её рисует карточка вкладки,
                 иначе у выбранной вкладки получаются две обводки. -->
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="ToolTipService.ShowDuration" Value="20000" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="TabSurface" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Margin="3,0" Padding="8,0" Height="38" VerticalAlignment="Center" MinWidth="130" MaxWidth="235">
                <Border.ToolTip>
                  <ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Text/Secondary}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Сохранено локально" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Text" Value="Есть несохранённые изменения" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding ModifiedAt,StringFormat=Изменён: {0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource Text/Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:AppIcon Kind="Document" Width="16" Height="16" Foreground="{DynamicResource Accent/Hover}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource Text/Primary}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Ellipse Grid.Column="2" Width="7" Height="7" Margin="3,0,4,0" Fill="{DynamicResource State/Warning}" Visibility="{Binding IsDirty,Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Есть несохранённые изменения" />
                  <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="×" Width="25" Height="25" MinHeight="25" ToolTip="Закрыть вкладку (Ctrl+W)" Click="CloseTab_Click" />
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Background/Selected}" />
                  <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent/Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Border/Strong}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="SettingsTabHeader" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Margin="6,0" Padding="10,0" Height="38" VerticalAlignment="Center" Width="210" HorizontalAlignment="Left" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:AppIcon Kind="Settings" Width="16" Height="16" Foreground="{DynamicResource Accent/Hover}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Настройки" Foreground="{DynamicResource Text/Primary}" FontWeight="SemiBold" Margin="9,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="×" Width="25" Height="25" MinHeight="25" Click="Settings_Click" ToolTip="Закрыть настройки" />
          </Grid>
        </Border>
        <!-- Список открытых вкладок открывается из меню приложения: отдельная кнопка в строке
             заголовка рисовалась пустым квадратом (стиль IconButton показывает только текстовый
             значок) и мешала. -->
        <Popup x:Name="TabsOverflowPopup" PlacementTarget="{Binding ElementName=AppMenuButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Width="280" MaxHeight="420" Padding="6" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="408">
              <ItemsControl x:Name="TabsOverflowList" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button HorizontalContentAlignment="Stretch" Click="TabsOverflowItem_Click" Tag="{Binding}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                        <Ellipse Grid.Column="1" Width="6" Height="6" Margin="8,0,0,0" Fill="{DynamicResource State/Warning}" Visibility="{Binding IsDirty,Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Есть несохранённые изменения" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Popup>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="＋" HorizontalAlignment="Left" VerticalAlignment="Center" Click="CreateMenu_Click" ToolTip="Создать или импортировать" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <StackPanel x:Name="TitleTools" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border x:Name="TopSearchBorder" Width="202" Height="34" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
              <TextBlock Text="⌕" Foreground="{DynamicResource Text/Muted}" FontSize="19" Margin="9,0,5,0" VerticalAlignment="Center" />
              <!-- Поиск не фильтрует дерево слева: найденное показывается списком под строкой. -->
              <TextBox x:Name="GlobalSearchBox" AutomationProperties.Name="Поиск документов и команд" AutomationProperties.HelpText="Введите запрос: найденное появится списком под строкой. Enter открывает полный поиск. Горячая клавиша Ctrl+K." TextChanged="GlobalSearch_TextChanged" PreviewKeyDown="GlobalSearch_PreviewKeyDown" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text/Muted}" Padding="0" VerticalContentAlignment="Center" ToolTip="Поиск по названиям и содержимому (Ctrl+K)" />
            </DockPanel>
          </Border>
          <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=TopSearchBorder}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False">
            <Border Width="330" Padding="7" Margin="0,4,0,0" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Medium}" Effect="{StaticResource Shadow.Popup}">
              <StackPanel>
                <TextBlock x:Name="SearchResultsHeaderText" Text="НАЙДЕНО" Foreground="{DynamicResource Text/Muted}" FontSize="11" Margin="8,4,8,6" />
                <ItemsControl x:Name="SearchResultsList" MaxHeight="330">
                  <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button HorizontalContentAlignment="Stretch" Click="SearchResult_Click" Tag="{Binding}" Margin="1" Padding="8,6" Background="Transparent" BorderThickness="0">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource Text/Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxHeight="30" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SearchResultsEmptyText" Visibility="Collapsed" Text="Ничего не найдено" Foreground="{DynamicResource Text/Muted}" Margin="8,4,8,6" />
                <Button Content="Расширенный поиск (Enter)" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="1,4,1,1" Padding="8,6" Click="AdvancedSearch_Click" />
              </StackPanel>
            </Border>
          </Popup>
          <Button Style="{StaticResource IconButton}" Content="◇" ToolTip="Теги текущего документа" Click="Tags_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Style="{StaticResource IconButton}" Content="?" ToolTip="Справка" Click="About_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click" />
          <Button Style="{StaticResource IconButton}" Content="□" Click="Maximize_Click" />
          <Button Style="{StaticResource IconButton}" Content="×" FontSize="22" Click="Exit_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Основная рабочая область -->
    <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="5,5,5,0">
      <Grid.ColumnDefinitions>
        <!-- Ниже 215 подпись кнопки создания перестаёт помещаться. -->
        <ColumnDefinition x:Name="LibraryColumn" Width="255" MinWidth="215" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition x:Name="StructureColumn" Width="225" MinWidth="160" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="420" />
        <ColumnDefinition Width="6" />
        <!-- Ниже 280 подписи и поле состояния начинают обрезаться, поэтому уже панель не сужается. -->
        <ColumnDefinition x:Name="PropertiesColumn" Width="290" MinWidth="280" />
      </Grid.ColumnDefinitions>
      <!-- Левая навигация -->
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid Margin="8">
              <!-- Отступы подобраны под минимальную ширину панели: иначе обрезается и подпись, и стрелка. -->
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
              <Button Content="＋  Создать документ" Height="36" Margin="0" Padding="10,7" Style="{StaticResource PrimaryButtonStyle}" Click="NewDocument_Click" ToolTip="Создать документ (Ctrl+N)" />
              <Button x:Name="CreateMenuArrowButton" Grid.Column="1" Height="36" Margin="3,0,0,0" Padding="0" Style="{StaticResource PrimaryButtonStyle}" Click="CreateMenu_Click" ToolTip="Другие варианты создания">
                <ui:AppIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{DynamicResource Text/OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </Grid>
            <Popup x:Name="CreateMenuPopup" PlacementTarget="{Binding ElementName=CreateMenuArrowButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
              <Border Width="240" Padding="7" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="СОЗДАТЬ" Foreground="{DynamicResource Text/Muted}" FontSize="11" Margin="9,5,9,7" />
                  <Button Content="▧   Новый документ" HorizontalContentAlignment="Left" Click="NewDocument_Click" />
                  <Button Content="▣   Документ из шаблона" HorizontalContentAlignment="Left" Click="NewFromTemplate_Click" />
                  <Button Content="▱   Новая папка" HorizontalContentAlignment="Left" Click="NewFolder_Click" />
                  <Button Content="▰   Новый раздел" HorizontalContentAlignment="Left" Click="NewSection_Click" />
                  <Separator />
                  <Button Content="⇩   Импорт документа" HorizontalContentAlignment="Left" Click="ImportDocument_Click" ToolTip="Импортировать документ (Ctrl+O)" />
                  <Button Content="⛁   Импорт из базы данных" HorizontalContentAlignment="Left" Click="DatabaseTransfer_Click" ToolTip="Выбрать документы в базе данных и импортировать их, либо выгрузить свои документы в базу" />
                  <Button Content="◇   Новый шаблон" HorizontalContentAlignment="Left" Click="NewTemplate_Click" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,2,0,8">
            <Button Style="{StaticResource NavButton}" Click="AllDocuments_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="▧   Все документы" />
                <TextBlock x:Name="AllDocumentsCountText" Grid.Column="1" Foreground="{DynamicResource Text/Muted}" Margin="12,0,0,0" />
              </Grid>
            </Button>
            <Button Style="{StaticResource NavButton}" Click="Favorites_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="☆   Избранное" />
                <TextBlock x:Name="FavoritesCountText" Grid.Column="1" Foreground="{DynamicResource Text/Muted}" Margin="12,0,0,0" />
              </Grid>
            </Button>
            <Button Style="{StaticResource NavButton}" Click="Recent_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="◷   Недавние" />
                <TextBlock x:Name="RecentDocumentsCountText" Grid.Column="1" Foreground="{DynamicResource Text/Muted}" Margin="12,0,0,0" />
              </Grid>
            </Button>
            <Button Style="{StaticResource NavButton}" Click="Trash_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="♲   Корзина" />
                <TextBlock x:Name="TrashCountText" Grid.Column="1" Foreground="{DynamicResource Text/Muted}" Margin="12,0,0,0" />
              </Grid>
              <!-- Очистка корзины — по самой корзине, а не в меню любого документа. -->
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Очистить корзину" Click="EmptyTrash_Click" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Separator />
            <Grid Margin="14,8,14,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="РАЗДЕЛЫ" Foreground="{DynamicResource Text/Secondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Grid Grid.Column="1">
                <Button x:Name="SectionAddButton" Content="＋" ToolTip="Добавить документ или папку" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Click="SectionAdd_Click" />
                <Popup x:Name="SectionAddPopup" PlacementTarget="{Binding ElementName=SectionAddButton}" Placement="Bottom" HorizontalOffset="-150" StaysOpen="False" AllowsTransparency="True">
                  <Border Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="7" Padding="6" Width="190">
                    <StackPanel>
                      <TextBlock Text="Добавить в разделы" Foreground="{DynamicResource Text/Muted}" FontSize="11" Margin="9,5,9,6" />
                      <Button Content="▧   Новый документ" HorizontalContentAlignment="Left" Click="SectionAddDocument_Click" />
                      <Button Content="▱   Новая папка" HorizontalContentAlignment="Left" Click="SectionAddFolder_Click" />
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="2">
          <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" ContextMenuOpening="Tree_ContextMenuOpening" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_DoubleClick" AllowDrop="True" PreviewMouseMove="Tree_MouseMove" Drop="Tree_Drop" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text/Primary}" Margin="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <EventSetter Event="Expanded" Handler="Tree_ExpansionChanged" />
                <EventSetter Event="Collapsed" Handler="Tree_ExpansionChanged" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type m:NodeItem}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                  <ui:AppIcon Kind="{Binding IsFolder, Converter={StaticResource NodeIconConverter}}" Width="16" Height="16" Foreground="{DynamicResource Text/Secondary}" Margin="0,0,7,0" />
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.Resources>
