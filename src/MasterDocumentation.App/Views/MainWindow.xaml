<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MasterDocumentation.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:MasterDocumentation.Models;assembly=MasterDocumentation.Core" xmlns:editor="clr-namespace:MasterDocumentation.Editor;assembly=MasterDocumentation.Editor" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:MasterDocumentation.Views" xmlns:ui="clr-namespace:MasterDocumentation.UI" Title="MasterDocumentation" Width="1536" Height="1024" MinWidth="900" MinHeight="640" Style="{x:Null}" WindowStyle="None" Background="{DynamicResource WindowBrush}" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
    <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
  </Window.CommandBindings>
  <Window.Resources>
    <HierarchicalDataTemplate x:Key="OutlineTemplate" ItemsSource="{Binding Children}">
      <Border x:Name="OutlineSurface" Background="Transparent" CornerRadius="{StaticResource Radius.Small}" Padding="5,4">
        <TextBlock x:Name="OutlineText" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
      </Border>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="OutlineSurface" Property="Background" Value="{DynamicResource Accent/Soft}" />
          <Setter TargetName="OutlineText" Property="Foreground" Value="{DynamicResource Text/Primary}" />
          <Setter TargetName="OutlineText" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>
    <views:ToastHost x:Name="Notifications" Grid.RowSpan="3" Panel.ZIndex="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Grid x:Name="OperationOverlay" Grid.RowSpan="3" Panel.ZIndex="90" Visibility="Collapsed" Background="{DynamicResource Background/Overlay}">
      <Border Width="430" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Strong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Large}">
        <StackPanel>
          <TextBlock x:Name="OperationTitle" Style="{StaticResource Typography.SectionTitle}" Text="Выполняется операция" />
          <TextBlock x:Name="OperationDescription" Margin="0,7,0,16" Foreground="{DynamicResource Text/Secondary}" Text="Пожалуйста, не закрывайте приложение." TextWrapping="Wrap" />
          <ProgressBar Height="6" IsIndeterminate="True" AutomationProperties.Name="Выполнение операции" />
        </StackPanel>
      </Border>
    </Grid>
    <!-- Верхняя строка приложения -->
    <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="BrandColumn" Width="260" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource Accent/Primary}">
            <ui:AppIcon Kind="App" Width="14" Height="14" Foreground="{DynamicResource Text/OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MasterDocumentation" Foreground="{DynamicResource Text/Primary}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
          <Button x:Name="AppMenuButton" Style="{StaticResource IconButton}" Content="☰" FontSize="15" ToolTip="Меню приложения" Click="AppMenu_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Создать документ" InputGestureText="Ctrl+N" Click="NewDocument_Click" />
                <MenuItem Header="Создать папку" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click" />
                <Separator />
                <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Command="ApplicationCommands.Save" />
                <MenuItem Header="Резервная копия" Click="Backup_Click" />
                <MenuItem Header="Восстановить" Click="Restore_Click" />
                <MenuItem Header="Экспорт" InputGestureText="Ctrl+Shift+S" Click="Export_Click" />
                <Separator />
                <MenuItem x:Name="LibraryPanelMenuItem" Header="Показывать библиотеку" IsCheckable="True" IsChecked="True" Click="ToggleLibraryPanel_Click" />
                <MenuItem x:Name="StructurePanelMenuItem" Header="Показывать структуру" IsCheckable="True" IsChecked="True" Click="ToggleStructurePanel_Click" />
                <MenuItem x:Name="PropertiesPanelMenuItem" Header="Показывать свойства" IsCheckable="True" IsChecked="True" Click="TogglePropertiesPanel_Click" />
                <MenuItem Header="Режим фокусировки" InputGestureText="Ctrl+Shift+F" Click="FocusMode_Click" />
                <Separator />
                <MenuItem Header="Тёмная тема" IsCheckable="True" IsChecked="{Binding DarkTheme}" />
                <MenuItem Header="О программе" Click="About_Click" />
                <MenuItem Header="Выход" InputGestureText="Alt+F4" Click="Exit_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <ListBox x:Name="Tabs" Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab,Mode=TwoWay}" SelectionChanged="Tabs_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="TabSurface" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Margin="3,7" Padding="8,0" Height="40" MinWidth="130" MaxWidth="235">
                <Border.ToolTip>
                  <ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Text/Secondary}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Сохранено локально" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Text" Value="Есть несохранённые изменения" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding ModifiedAt,StringFormat=Изменён: {0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource Text/Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:AppIcon Kind="Document" Width="16" Height="16" Foreground="{DynamicResource Accent/Hover}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource Text/Primary}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Ellipse Grid.Column="2" Width="7" Height="7" Margin="3,0,4,0" Fill="{DynamicResource State/Warning}" Visibility="{Binding IsDirty,Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Есть несохранённые изменения" />
                  <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="×" Width="25" Height="25" MinHeight="25" ToolTip="Закрыть вкладку (Ctrl+W)" Click="CloseTab_Click" />
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Background/Selected}" />
                  <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent/Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Border/Strong}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="SettingsTabHeader" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Margin="6,7" Padding="10,0" Height="40" Width="210" HorizontalAlignment="Left" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:AppIcon Kind="Settings" Width="16" Height="16" Foreground="{DynamicResource Accent/Hover}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Настройки" Foreground="{DynamicResource Text/Primary}" FontWeight="SemiBold" Margin="9,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="×" Width="25" Height="25" MinHeight="25" Click="Settings_Click" ToolTip="Закрыть настройки" />
          </Grid>
        </Border>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="＋" HorizontalAlignment="Left" VerticalAlignment="Center" Click="CreateMenu_Click" ToolTip="Создать или импортировать" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <StackPanel x:Name="TitleTools" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border x:Name="TopSearchBorder" Width="202" Height="34" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
              <TextBlock Text="⌕" Foreground="{DynamicResource MutedTextBrush}" FontSize="19" Margin="9,0,5,0" VerticalAlignment="Center" />
              <TextBox x:Name="GlobalSearchBox" AutomationProperties.Name="Поиск документов и команд" AutomationProperties.HelpText="Введите запрос и нажмите Enter. Горячая клавиша Ctrl+K." Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="GlobalSearch_PreviewKeyDown" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedTextBrush}" Padding="0" VerticalContentAlignment="Center" ToolTip="Поиск по названиям и содержимому (Ctrl+K)" />
            </DockPanel>
          </Border>
          <Button Style="{StaticResource IconButton}" Content="◇" ToolTip="Теги текущего документа" Click="Tags_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Style="{StaticResource IconButton}" Content="?" ToolTip="Справка" Click="About_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click" />
          <Button Style="{StaticResource IconButton}" Content="□" Click="Maximize_Click" />
          <Button Style="{StaticResource IconButton}" Content="×" FontSize="22" Click="Exit_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Основная рабочая область -->
    <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="5,5,5,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LibraryColumn" Width="255" MinWidth="190" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition x:Name="StructureColumn" Width="225" MinWidth="160" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="420" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition x:Name="PropertiesColumn" Width="265" MinWidth="210" />
      </Grid.ColumnDefinitions>
      <!-- Левая навигация -->
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid Margin="8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
              <Button Content="＋  Создать документ" Height="36" Margin="0" Style="{StaticResource PrimaryButtonStyle}" Click="NewDocument_Click" ToolTip="Создать документ (Ctrl+N)" />
              <Button x:Name="CreateMenuArrowButton" Grid.Column="1" Height="36" Margin="3,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="CreateMenu_Click" ToolTip="Другие варианты создания">
                <ui:AppIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{DynamicResource Text/OnAccent}" />
              </Button>
            </Grid>
            <Popup x:Name="CreateMenuPopup" PlacementTarget="{Binding ElementName=CreateMenuArrowButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
              <Border Width="240" Padding="7" Background="{DynamicResource ElevatedPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="СОЗДАТЬ" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="9,5,9,7" />
                  <Button Content="▧   Новый документ" HorizontalContentAlignment="Left" Click="NewDocument_Click" />
                  <Button Content="▣   Документ из шаблона" HorizontalContentAlignment="Left" Click="NewFromTemplate_Click" />
                  <Button Content="▱   Новая папка" HorizontalContentAlignment="Left" Click="NewFolder_Click" />
                  <Button Content="▰   Новый раздел" HorizontalContentAlignment="Left" Click="NewSection_Click" />
                  <Separator />
                  <Button Content="⇩   Импорт документа" HorizontalContentAlignment="Left" Click="ImportDocument_Click" />
                  <Button Content="◇   Новый шаблон" HorizontalContentAlignment="Left" Click="NewTemplate_Click" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,2,0,8">
            <Button Style="{StaticResource NavButton}" Click="AllDocuments_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="▧   Все документы" />
                <TextBlock x:Name="AllDocumentsCountText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>
            <Button Style="{StaticResource NavButton}" Click="Favorites_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="☆   Избранное" />
                <TextBlock x:Name="FavoritesCountText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>
            <Button Style="{StaticResource NavButton}" Click="Recent_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="◷   Недавние" />
                <TextBlock x:Name="RecentDocumentsCountText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>
            <Button Style="{StaticResource NavButton}" Click="Trash_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="♲   Корзина" />
                <TextBlock x:Name="TrashCountText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>
            <Separator />
            <Grid Margin="14,8,14,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="РАЗДЕЛЫ" Foreground="{DynamicResource Text/Secondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Grid Grid.Column="1">
                <Button x:Name="SectionAddButton" Content="＋" ToolTip="Добавить документ или папку" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Click="SectionAdd_Click" />
                <Popup x:Name="SectionAddPopup" PlacementTarget="{Binding ElementName=SectionAddButton}" Placement="Bottom" HorizontalOffset="-150" StaysOpen="False" AllowsTransparency="True">
                  <Border Background="{DynamicResource ElevatedPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6" Width="190">
                    <StackPanel>
                      <TextBlock Text="Добавить в разделы" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="9,5,9,6" />
                      <Button Content="▧   Новый документ" HorizontalContentAlignment="Left" Click="SectionAddDocument_Click" />
                      <Button Content="▱   Новая папка" HorizontalContentAlignment="Left" Click="SectionAddFolder_Click" />
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="2">
          <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_DoubleClick" AllowDrop="True" PreviewMouseMove="Tree_MouseMove" Drop="Tree_Drop" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Margin="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <EventSetter Event="Expanded" Handler="Tree_ExpansionChanged" />
                <EventSetter Event="Collapsed" Handler="Tree_ExpansionChanged" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type m:NodeItem}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                  <ui:AppIcon Kind="{Binding IsFolder, Converter={StaticResource NodeIconConverter}}" Width="16" Height="16" Foreground="{DynamicResource Text/Secondary}" Margin="0,0,7,0" />
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Открыть" Click="OpenNode_Click" />
                <MenuItem Header="Создать копию" Click="DuplicateSelectedNode_Click" />
                <MenuItem Header="Копировать внутреннюю ссылку" Click="CopyDocumentLink_Click" />
                <MenuItem Header="В избранное / убрать" Click="FavoriteNode_Click" />
                <MenuItem Header="Использовать как шаблон" Click="MakeTemplate_Click" />
                <MenuItem Header="Переименовать" InputGestureText="F2" Click="Rename_Click" />
                <Separator />
                <MenuItem Header="Свернуть все узлы" Click="CollapseAll_Click" />
                <Separator />
                <MenuItem Header="Восстановить из корзины" Click="RestoreNode_Click" />
                <MenuItem Header="Переместить в корзину" InputGestureText="Delete" Click="Delete_Click" />
                <MenuItem Header="Удалить окончательно" Click="DeletePermanently_Click" />
                <MenuItem Header="Очистить корзину" Click="EmptyTrash_Click" />
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
            <StackPanel x:Name="NavigationEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="205" Margin="16">
              <ui:AppIcon x:Name="NavigationEmptyIcon" Kind="Documents" Width="30" Height="30" Foreground="{DynamicResource Text/Muted}" HorizontalAlignment="Center" />
              <TextBlock x:Name="NavigationEmptyTitle" Text="Здесь пока пусто" Margin="0,10,0,0" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock x:Name="NavigationEmptyDescription" Text="Создайте первый документ, чтобы начать работу." Margin="0,5,0,10" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" TextAlignment="Center" />
              <Button x:Name="NavigationEmptyAction" Content="Создать документ" Style="{StaticResource PrimaryButtonStyle}" Click="NewDocument_Click" />
            </StackPanel>
          </Grid>
          <UniformGrid Grid.Row="3" Columns="2" Margin="6,5">
            <Button Style="{StaticResource NavButton}" Content="▣  Шаблоны" Click="Templates_Click" ToolTip="Открыть шаблоны документов" FontSize="11" Padding="3" Margin="1" />
            <Button Style="{StaticResource NavButton}" Content="▦  Приложения" Click="Applications_Click" ToolTip="Открыть локальные инструменты" FontSize="11" Padding="3" Margin="1" />
          </UniformGrid>
          <Grid Grid.Row="4" Background="{DynamicResource ElevatedPanelBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="48" />
              <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <Grid Margin="12,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="24" Height="24" Background="{DynamicResource State/SuccessSoft}" CornerRadius="{StaticResource Radius.Pill}">
                <ui:AppIcon Kind="Storage" Width="15" Height="15" Foreground="{DynamicResource State/Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="9,0,5,0">
                <TextBlock Text="Локальное хранилище" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StorageLocationText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ui:AppIcon Grid.Column="2" Kind="Success" Width="14" Height="14" Foreground="{DynamicResource State/Success}" Margin="3,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <UniformGrid Grid.Row="1" Columns="4">
              <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="Открыть настройки" Click="Settings_Click" />
              <Button Style="{StaticResource IconButton}" Content="◉" ToolTip="Проверить целостность хранилища" Click="StorageHealth_Click" />
              <Button Style="{StaticResource IconButton}" Content="☾" ToolTip="Переключить светлую или тёмную тему" Click="ThemeQuickToggle_Click" />
              <Button Style="{StaticResource IconButton}" Content="▣" ToolTip="Открыть папку данных" Click="OpenDataFolder_Click" />
            </UniformGrid>
          </Grid>
        </Grid>
      </Border>
      <!-- Структура документа -->
      <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="StructureTab" Style="{StaticResource PanelTab}" Content="Структура" IsChecked="True" Click="StructureTab_Click" />
            <ToggleButton x:Name="HeadersTab" Grid.Column="1" Style="{StaticResource PanelTab}" Content="Заголовки" Click="HeadersTab_Click" />
          </Grid>
          <Grid Grid.Row="1">
            <TreeView x:Name="StructureTree" ItemTemplate="{StaticResource OutlineTemplate}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text/Secondary}" Margin="8" MouseDoubleClick="Heading_DoubleClick" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <ListBox x:Name="HeadersList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text/Secondary}" Margin="8" MouseDoubleClick="Heading_DoubleClick" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" Padding="7,5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="OutlineEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" MaxWidth="190">
              <ui:AppIcon Kind="ListNumbered" Width="28" Height="28" Foreground="{DynamicResource Text/Muted}" HorizontalAlignment="Center" />
