                <StackPanel x:Name="TocEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" MaxWidth="205">
                  <ui:AppIcon Kind="ListNumbered" Width="25" Height="25" Foreground="{DynamicResource Text/Muted}" HorizontalAlignment="Center" />
                  <TextBlock Text="Оглавление появится после добавления заголовков." Margin="0,8,0,0" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </DockPanel>
          </Border>
          <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,16">
                <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,11" />
                <Button x:Name="ExportDocumentButton" Style="{StaticResource NavButton}" Background="{DynamicResource ButtonSurfaceBrush}" Content="⇧   Экспорт документа" Click="ExportDocument_Click" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource ButtonSurfaceBrush}" Content="▣   Печать" Click="Print_Click" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource ButtonSurfaceBrush}" Content="▤   Создать копию" Click="Duplicate_Click" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource ButtonSurfaceBrush}" Content="◴   История версий" Click="History_Click" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource ButtonSurfaceBrush}" Content="⚙   Все свойства" Click="DocumentProperties_Click" />
                <Separator />
                <TextBlock Text="ВЫБРАННОЕ ИЗОБРАЖЕНИЕ" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="2,4,0,5" />
                <WrapPanel>
                  <Button Content="−" ToolTip="Уменьшить" Click="ImageSmaller_Click" />
                  <Button Content="＋" ToolTip="Увеличить" Click="ImageLarger_Click" />
                  <Button Content="↶" ToolTip="Повернуть влево" Tag="-90" Click="ImageRotate_Click" />
                  <Button Content="↷" ToolTip="Повернуть вправо" Tag="90" Click="ImageRotate_Click" />
                  <Button Content="⇤" ToolTip="По левому краю" Tag="left" Click="ImageAlign_Click" />
                  <Button Content="↔" ToolTip="По центру" Tag="center" Click="ImageAlign_Click" />
                  <Button Content="⇥" ToolTip="По правому краю" Tag="right" Click="ImageAlign_Click" />
                  <Button Content="ALT" ToolTip="Альтернативный текст" Click="ImageAlt_Click" />
                  <Button Content="CAP" ToolTip="Подпись под изображением" Click="ImageCaption_Click" />
                  <Button Content="✂" ToolTip="Обрезать по краям" Click="ImageCrop_Click" />
                  <Button Content="≈" ToolTip="Сжать в JPEG с выбором качества" Click="ImageCompress_Click" />
                  <Button Content="⧉" ToolTip="Копировать изображение" Click="ImageCopy_Click" />
                  <Button Content="↤" Tag="left" ToolTip="Обтекание текстом слева" Click="ImageWrap_Click" />
                  <Button Content="↦" Tag="right" ToolTip="Обтекание текстом справа" Click="ImageWrap_Click" />
                  <Button Content="□" Tag="none" ToolTip="Без обтекания" Click="ImageWrap_Click" />
                  <Button Content="⟳" ToolTip="Заменить файл" Click="ImageReplace_Click" />
                  <Button Content="⛶" ToolTip="Открыть оригинал" Click="ImageOpen_Click" />
                  <Button Content="⌫" Foreground="{DynamicResource State/Error}" ToolTip="Удалить изображение из документа" Tag="imageDelete" Click="ModernCommand_Click" />
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Grid x:Name="AttachmentsPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" Panel.ZIndex="5" Margin="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="14,16,14,10">
              <TextBlock Text="ВЛОЖЕНИЯ ДОКУМЕНТА" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
              <TextBlock Text="Файлы хранятся локально; одинаковые файлы не дублируются на диске." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
            <Grid Grid.Row="1">
            <ListBox x:Name="AttachmentList" Margin="10,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" SelectionMode="Single">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource ElevatedPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2,3">
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                      <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0">
                        <Run Text="{Binding MimeType}" />
                        <Run Text="  •  " />
                        <Run Text="{Binding Size}" />
                        <Run Text=" байт" />
                      </TextBlock>
                      <TextBlock Text="{Binding CreatedAt,StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <StackPanel x:Name="AttachmentsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="215" Margin="16">
                <ui:AppIcon Kind="Attachment" Width="30" Height="30" Foreground="{DynamicResource Text/Muted}" HorizontalAlignment="Center" />
                <TextBlock Text="Вложений пока нет" Margin="0,10,0,0" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Добавьте файл — он сохранится локально вместе с документом." Margin="0,5,0,0" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Margin="12,10,12,14">
              <Button Content="＋ Добавить вложение" Click="AddAttachment_Click" />
              <UniformGrid Columns="3">
                <Button Content="Открыть" Click="OpenAttachment_Click" />
                <Button Content="Показать в папке" Click="ShowAttachmentInFolder_Click" />
                <Button Content="Сохранить как…" Click="SaveAttachment_Click" />
              </UniformGrid>
              <Button Content="Удалить связь" Click="RemoveAttachment_Click" Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True" ToolTip="Изменить ширину библиотеки" />
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True" ToolTip="Изменить ширину структуры" />
      <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True" ToolTip="Изменить ширину свойств" />
      <ContentControl x:Name="SettingsHost" Grid.Column="2" Grid.ColumnSpan="5" Visibility="Collapsed" Panel.ZIndex="30" Background="{DynamicResource WindowBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    <!-- Строка состояния -->
    <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock x:Name="DocumentStatsText" Text="Слов: 0   Символов: 0" Foreground="{DynamicResource Text/Muted}" />
        <TextBlock x:Name="SaveStatusText" Text="Сохранено" Foreground="{DynamicResource Text/Muted}" MinWidth="150" Margin="30,0,0,0" Cursor="Hand" MouseLeftButtonDown="SaveStatus_Click" ToolTip="Состояние сохранения. При ошибке нажмите, чтобы повторить." />
        <TextBlock Text="{Binding SelectedTab.ModifiedAt,StringFormat=Изменено: {0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource Text/Muted}" Margin="30,0,20,0" />
        <Separator />
        <Button Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Content="−" ToolTip="Уменьшить масштаб" Click="ZoomOut_Click" />
        <TextBlock x:Name="ZoomText" Text="100%" Foreground="{DynamicResource MutedTextBrush}" Margin="9,0" MouseLeftButtonDown="ZoomReset_Click" ToolTip="Сбросить масштаб" />
        <Button Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Content="＋" ToolTip="Увеличить масштаб" Click="ZoomIn_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
