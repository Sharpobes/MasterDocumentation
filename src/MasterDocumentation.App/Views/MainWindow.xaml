                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding ModifiedAt,StringFormat={}{0:dd.MM HH:mm}}" Foreground="{DynamicResource Text/Muted}" Margin="12,0,0,0" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                    <Border x:Name="StartQuickCard" Grid.Column="2" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="7" Padding="14">
                      <StackPanel>
                        <TextBlock Text="Быстрый доступ" FontWeight="SemiBold" Margin="3,0,0,8" />
                        <Button Content="▱  Открыть папку данных" HorizontalContentAlignment="Left" Click="OpenDataFolder_Click" />
                        <Button Content="↥  Создать резервную копию" HorizontalContentAlignment="Left" Click="Backup_Click" />
                        <Button Content="↧  Восстановить копию" HorizontalContentAlignment="Left" Click="Restore_Click" />
                        <Button Content="⛁  База данных: импорт и выгрузка" HorizontalContentAlignment="Left" Click="DatabaseTransfer_Click" />
                        <Button Content="⚙  Настройки" HorizontalContentAlignment="Left" Click="Settings_Click" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Border Grid.Row="3" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="6" Padding="13">
                    <TextBlock x:Name="StartStatisticsText" Foreground="{DynamicResource Text/Muted}" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" />
                  </Border>
                </Grid>
              </ScrollViewer>
            </Grid>
            <editor:TiptapEditor x:Name="ModernEditor" Visibility="Collapsed" ContentChanged="ModernEditor_ContentChanged" SelectionChanged="ModernEditor_SelectionChanged" FileDropped="ModernEditor_FileDropped" AssetOpenRequested="ModernEditor_AssetOpenRequested" ImageMissing="ModernEditor_ImageMissing" InitializationFailed="ModernEditor_InitializationFailed" LinkOpenRequested="ModernEditor_LinkOpenRequested" EditorReady="ModernEditor_Ready" />
            <RichTextBox x:Name="Editor" Visibility="Collapsed" AcceptsTab="True" Padding="38,22" BorderThickness="0" Background="{DynamicResource Background/Editor}" Foreground="{DynamicResource Text/Primary}" FontSize="15" CaretBrush="{DynamicResource Text/Primary}" VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" PreviewKeyDown="Editor_PreviewKeyDown" PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown" SpellCheck.IsEnabled="True" />
          </Grid>
        </Grid>
      </Border>
      <!-- Свойства -->
      <Border Grid.Column="6" Style="{StaticResource PanelBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text/Primary}" FontWeight="SemiBold" Click="PropertiesTab_Click" ToolTip="Свойства и оглавление документа">
              <TextBlock Text="Свойства" />
            </Button>
            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text/Muted}" Click="AttachmentsTab_Click" ToolTip="Файлы, связанные с документом">
              <TextBlock x:Name="AttachmentsHeaderText" Text="Вложения (0)" />
            </Button>
            <Border x:Name="PropertiesTabIndicator" Height="2" Background="{DynamicResource Accent/Primary}" VerticalAlignment="Bottom" />
            <Border x:Name="AttachmentsTabIndicator" Grid.Column="1" Height="2" Background="{DynamicResource Accent/Primary}" VerticalAlignment="Bottom" Visibility="Collapsed" />
          </Grid>
          <Grid Grid.Row="1" Margin="14,15">
            <Grid.ColumnDefinitions>
              <!-- Ширина по самой длинной подписи: при фиксированных 90 «Тип документа» упирался в значение. -->
              <ColumnDefinition Width="Auto" MinWidth="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="38" />
              <RowDefinition Height="48" />
              <RowDefinition Height="52" />
              <RowDefinition Height="38" />
              <RowDefinition Height="38" />
              <RowDefinition Height="38" />
            </Grid.RowDefinitions>
            <TextBlock Text="Тип документа" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Документ" Foreground="{DynamicResource Text/Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Text="Статус" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Grid Grid.Row="1" Grid.Column="1">
              <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource State/Info}" Panel.ZIndex="2" IsHitTestVisible="False" />
              <!-- Минимальная ширина под самое длинное состояние («На проверке»): при сужении панели слово обрезалось. -->
              <ComboBox x:Name="StatusBox" MinWidth="142" Padding="24,6,34,6" SelectionChanged="Status_Changed">
                <ComboBoxItem Content="Черновик" />
                <ComboBoxItem Content="В работе" />
                <ComboBoxItem Content="На проверке" />
                <ComboBoxItem Content="Завершён" />
                <ComboBoxItem Content="Архив" />
              </ComboBox>
            </Grid>
            <TextBlock Grid.Row="2" Text="Теги" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Padding="5,3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="TagChips">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- Скругление как у остальных элементов интерфейса: чип-«таблетка» выбивался из общего вида. -->
                      <Border Background="{DynamicResource Accent/Soft}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Padding="6,1,2,1" Margin="0,0,5,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding}" Foreground="{DynamicResource Text/Secondary}" MaxWidth="80" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center"/>
                          <Button Content="×" Style="{StaticResource IconButton}" Width="17" Height="17" MinHeight="17" Margin="3,0,0,0" Padding="0" FontSize="13" Click="RemoveTag_Click" ToolTip="Убрать тег" AutomationProperties.Name="Убрать тег"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TagsOverflowText" Visibility="Collapsed" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Button x:Name="TagsButton" Content="＋" Style="{StaticResource IconButton}" Width="22" Height="22" MinHeight="22" Padding="0" Click="Tags_Click" ToolTip="Теги документа" AutomationProperties.Name="Теги документа" />
              </StackPanel>
            </Border>
            <Popup x:Name="TagsPopup" PlacementTarget="{Binding ElementName=TagsButton}" Placement="Bottom" HorizontalOffset="-190" StaysOpen="False" AllowsTransparency="True">
              <Border Width="250" Padding="10" Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.Medium}" Effect="{StaticResource Shadow.Popup}">
                <StackPanel>
                  <TextBlock Text="Теги документа" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TagInputBox" Height="30" KeyDown="TagInput_KeyDown" AutomationProperties.Name="Новый тег" ToolTip="Введите тег и нажмите Enter" />
                    <Button Grid.Column="1" Content="Добавить" MinWidth="0" Padding="10,0" Height="30" Margin="6,0,0,0" Click="AddTag_Click" />
                  </Grid>
                  <TextBlock Text="Enter добавляет тег, окно остаётся открытым." Foreground="{DynamicResource Text/Muted}" FontSize="11" Margin="0,6,0,8" TextWrapping="Wrap" />
                  <ItemsControl x:Name="TagEditorList" MaxHeight="180">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                          <Button Grid.Column="1" Content="×" Style="{StaticResource IconButton}" Width="22" Height="22" MinHeight="22" Padding="0" Click="RemoveTag_Click" ToolTip="Убрать тег" AutomationProperties.Name="Убрать тег" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="TagEditorEmptyText" Text="Тегов пока нет" Foreground="{DynamicResource Text/Muted}" FontSize="11" />
                </StackPanel>
              </Border>
            </Popup>
            <TextBlock Grid.Row="3" Text="Создан" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTab.CreatedAt,StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource Text/Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="4" Text="Изменён" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTab.ModifiedAt,StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource Text/Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="5" Text="Автор" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Локальный пользователь" Foreground="{DynamicResource Text/Primary}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
          <!-- Оглавление убрано из свойств: те же заголовки показывает вкладка «Заголовки» слева. -->
          <Border Grid.Row="3" BorderBrush="{DynamicResource Border/Default}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,16">
                <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="{DynamicResource Text/Muted}" FontSize="12" Margin="0,0,0,11" />
                <Button x:Name="ExportDocumentButton" Style="{StaticResource NavButton}" Background="{DynamicResource Background/SurfaceElevated}" Content="⇧   Экспорт документа" Click="ExportDocument_Click" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource Background/SurfaceElevated}" Content="▣   Печать" Click="Print_Click" ToolTip="Печать документа (Ctrl+P)" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource Background/SurfaceElevated}" Content="▤   Создать копию" Click="Duplicate_Click" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource Background/SurfaceElevated}" Content="◴   История версий" Click="History_Click" />
                <Button Style="{StaticResource NavButton}" Background="{DynamicResource Background/SurfaceElevated}" Content="⚙   Все свойства" Click="DocumentProperties_Click" />
                <Separator />
                <TextBlock Text="ВЫБРАННОЕ ИЗОБРАЖЕНИЕ" Foreground="{DynamicResource Text/Muted}" FontSize="11" Margin="2,4,0,5" />
                <WrapPanel>
                  <Button Content="−" ToolTip="Уменьшить" Click="ImageSmaller_Click" />
                  <Button Content="＋" ToolTip="Увеличить" Click="ImageLarger_Click" />
                  <Button Content="↶" ToolTip="Повернуть влево" Tag="-90" Click="ImageRotate_Click" />
                  <Button Content="↷" ToolTip="Повернуть вправо" Tag="90" Click="ImageRotate_Click" />
                  <Button Content="⇤" ToolTip="По левому краю" Tag="left" Click="ImageAlign_Click" />
                  <Button Content="↔" ToolTip="По центру" Tag="center" Click="ImageAlign_Click" />
                  <Button Content="⇥" ToolTip="По правому краю" Tag="right" Click="ImageAlign_Click" />
                  <Button Content="ALT" ToolTip="Альтернативный текст" Click="ImageAlt_Click" />
                  <Button Content="CAP" ToolTip="Подпись под изображением" Click="ImageCaption_Click" />
                  <Button Content="✂" ToolTip="Обрезать по краям" Click="ImageCrop_Click" />
                  <Button Content="≈" ToolTip="Сжать в JPEG с выбором качества" Click="ImageCompress_Click" />
                  <Button Content="⧉" ToolTip="Копировать изображение" Click="ImageCopy_Click" />
                  <Button Content="↤" Tag="left" ToolTip="Обтекание текстом слева" Click="ImageWrap_Click" />
                  <Button Content="↦" Tag="right" ToolTip="Обтекание текстом справа" Click="ImageWrap_Click" />
                  <Button Content="□" Tag="none" ToolTip="Без обтекания" Click="ImageWrap_Click" />
                  <Button Content="⟳" ToolTip="Заменить файл" Click="ImageReplace_Click" />
                  <Button Content="⛶" ToolTip="Открыть оригинал" Click="ImageOpen_Click" />
                  <Button Content="⌫" Foreground="{DynamicResource State/Error}" ToolTip="Удалить изображение из документа" Tag="imageDelete" Click="ModernCommand_Click" />
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Grid x:Name="AttachmentsPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource Background/Surface}" Panel.ZIndex="5" Margin="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="14,16,14,10">
              <TextBlock Text="ВЛОЖЕНИЯ ДОКУМЕНТА" Foreground="{DynamicResource Text/Muted}" FontSize="12" />
              <TextBlock Text="Файлы хранятся локально; одинаковые файлы не дублируются на диске." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
            <Grid Grid.Row="1">
            <ListBox x:Name="AttachmentList" Margin="10,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text/Primary}" SelectionMode="Single" SelectionChanged="AttachmentList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Background/SurfaceElevated}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2,3">
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                      <TextBlock Foreground="{DynamicResource Text/Muted}" FontSize="11" Margin="0,4,0,0">
                        <Run Text="{Binding MimeType}" />
                        <Run Text="  •  " />
                        <Run Text="{Binding Size}" />
                        <Run Text=" байт" />
                      </TextBlock>
                      <TextBlock Text="{Binding CreatedAt,StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource Text/Muted}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <StackPanel x:Name="AttachmentsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="215" Margin="16">
                <ui:AppIcon Kind="Attachment" Width="30" Height="30" Foreground="{DynamicResource Text/Muted}" HorizontalAlignment="Center" />
                <TextBlock Text="Вложений пока нет" Margin="0,10,0,0" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Добавьте файл — он сохранится локально вместе с документом." Margin="0,5,0,0" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Margin="12,10,12,14">
              <Button Content="＋ Добавить вложение" Click="AddAttachment_Click" />
              <Button x:Name="ShowAttachmentInDocumentButton" Content="Показать в документе" Click="ShowAttachmentInDocument_Click" ToolTip="Выделить это изображение в тексте документа" />
              <UniformGrid Columns="3">
                <Button Content="Открыть" Click="OpenAttachment_Click" />
                <Button Content="Показать в папке" Click="ShowAttachmentInFolder_Click" />
                <Button Content="Сохранить как…" Click="SaveAttachment_Click" />
              </UniformGrid>
              <Button Content="Удалить связь" Click="RemoveAttachment_Click" Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True" ToolTip="Изменить ширину библиотеки" />
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True" ToolTip="Изменить ширину структуры" />
      <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True" ToolTip="Изменить ширину свойств" />
      <ContentControl x:Name="SettingsHost" Grid.Column="2" Grid.ColumnSpan="5" Visibility="Collapsed" Panel.ZIndex="30" Background="{DynamicResource Background/App}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    <!-- Строка состояния -->
    <Border Grid.Row="2" Background="{DynamicResource Background/App}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="0,1,0,0">
      <Grid>
      <Button x:Name="NotificationCenterButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Height="26" MinHeight="26" Padding="7,0" Click="NotificationCenter_Click" ToolTip="Все уведомления" AutomationProperties.Name="Все уведомления">
        <StackPanel Orientation="Horizontal">
          <ui:AppIcon Kind="Notification" Width="15" Height="15" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center" />
          <Border x:Name="NotificationBadge" Visibility="Collapsed" Margin="6,0,0,0" MinWidth="17" Height="16" Padding="4,0" CornerRadius="8" Background="{DynamicResource Accent/Primary}" VerticalAlignment="Center">
            <TextBlock x:Name="NotificationBadgeText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Text/OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock x:Name="DocumentStatsText" Text="Слов: 0   Символов: 0" Foreground="{DynamicResource Text/Muted}" />
        <TextBlock x:Name="SaveStatusText" Text="Сохранено" Foreground="{DynamicResource Text/Muted}" MinWidth="150" Margin="30,0,0,0" Cursor="Hand" MouseLeftButtonDown="SaveStatus_Click" ToolTip="Состояние сохранения. При ошибке нажмите, чтобы повторить." />
        <TextBlock Text="{Binding SelectedTab.ModifiedAt,StringFormat=Изменено: {0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource Text/Muted}" Margin="30,0,20,0" />
        <Separator />
        <Button Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Content="−" ToolTip="Уменьшить масштаб" Click="ZoomOut_Click" />
        <TextBlock x:Name="ZoomText" Text="100%" Foreground="{DynamicResource Text/Muted}" Margin="9,0" MouseLeftButtonDown="ZoomReset_Click" ToolTip="Сбросить масштаб" />
        <Button Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Content="＋" ToolTip="Увеличить масштаб" Click="ZoomIn_Click" />
      </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
