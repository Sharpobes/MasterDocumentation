<Window x:Class="MasterDocumentation.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MasterDocumentation.UI"
        Title="История версий"
        Width="1080"
        Height="620"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background/App}"
        Foreground="{DynamicResource Text/Primary}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="История версий документа" Style="{StaticResource Typography.PageTitle}"/>
            <TextBlock Text="Закреплённые версии не удаляются автоматической ротацией. Содержимое выбранной версии сравнивается с текущим документом."
                       Foreground="{DynamicResource Text/Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,14"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="VersionsList"
                         Background="{DynamicResource Background/Surface}"
                         Foreground="{DynamicResource Text/Primary}"
                         BorderBrush="{DynamicResource Border/Default}"
                         SelectionChanged="VersionsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="9" Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ui:AppIcon Kind="Star"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource State/Warning}"
                                                Visibility="{Binding IsPinned,Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding CreatedAt,StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource Text/Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size,StringFormat={}{0:N0} Б}" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="220">
                    <TextBlock Text="История пока пуста" Style="{StaticResource Typography.SectionTitle}" TextAlignment="Center"/>
                    <TextBlock Text="Версия появится после сохранения изменённого документа."
                               Foreground="{DynamicResource Text/Muted}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Выбранная версия" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Текущая версия" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBox x:Name="CurrentText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PinButton" Content="Закрепить / открепить" Click="TogglePin_Click"/>
                <Button x:Name="DeleteButton" Content="Удалить версию" Style="{StaticResource DangerButtonStyle}" Click="DeleteVersion_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Закрыть" IsCancel="True"/>
                <Button x:Name="RestoreButton" Content="Восстановить выбранную" Style="{StaticResource PrimaryButtonStyle}" Click="Restore_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
