<Window x:Class="MasterDocumentation.Views.DatabaseTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="База данных: импорт и выгрузка"
        Width="1000"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background/App}"
        Foreground="{DynamicResource Text/Primary}">
    <Window.Resources>
        <HierarchicalDataTemplate x:Key="SelectableNodeTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked,Mode=TwoWay}" IsThreeState="True" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Badge}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Text/Muted}"/>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Импорт и выгрузка документации в базу данных" Style="{StaticResource Typography.PageTitle}"/>
            <TextBlock Text="Выберите, какие локально сохранённые страницы отправить в общую базу данных, или какие страницы забрать из базы к себе. Изображения переносятся вместе со страницами и остаются видимыми у всех, кто подключён к этой базе."
                       Foreground="{DynamicResource Text/Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,14"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Строка подключения" VerticalAlignment="Center"/>
                    <TextBox x:Name="ConnectionBox" Grid.Column="1" AutomationProperties.Name="Строка подключения к базе данных"/>
                </Grid>
                <TextBlock Text="Пример: Host=localhost;Port=5432;Database=masterdocumentation;Username=postgres;Password=***"
                           Foreground="{DynamicResource Text/Muted}"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Имя пользователя базы" VerticalAlignment="Center"/>
                    <TextBox x:Name="UserBox" Grid.Column="1" AutomationProperties.Name="Имя пользователя базы данных"/>
                </Grid>
                <TextBlock Text="Под этим именем страницы помечаются как ваши: приватные страницы видны только их владельцу."
                           Foreground="{DynamicResource Text/Muted}"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Проверить соединение" Click="TestConnection_Click"/>
                    <Button Content="Сохранить как хранилище по умолчанию" Margin="8,0,0,0" Click="SaveAsDefault_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource Border/Default}">
            <TabItem Header="Выгрузить в базу данных">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Документы текущего хранилища. Отмеченные страницы будут записаны в базу данных вместе с вложениями и изображениями."
                               Foreground="{DynamicResource Text/Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <TreeView x:Name="LocalTree"
                              Grid.Row="1"
                              ItemTemplate="{StaticResource SelectableNodeTemplate}"
                              Background="{DynamicResource Background/Surface}"
                              BorderBrush="{DynamicResource Border/Default}"/>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Выбрать все" Click="SelectAllLocal_Click"/>
                            <Button Content="Снять выделение" Click="ClearLocal_Click"/>
                            <Button Content="Обновить список" Click="ReloadLocal_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="UploadPrivateCheck" Content="Сохранить как приватные" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="UploadButton" Content="Сохранить выбранное в базу данных" Style="{StaticResource PrimaryButtonStyle}" Click="Upload_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Импорт из базы данных">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Документы выбранной базы данных: общие страницы всех пользователей и ваши приватные. Отмеченные страницы будут добавлены в текущее хранилище."
                               Foreground="{DynamicResource Text/Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <TreeView x:Name="RemoteTree"
                              Grid.Row="1"
                              ItemTemplate="{StaticResource SelectableNodeTemplate}"
                              Background="{DynamicResource Background/Surface}"
                              BorderBrush="{DynamicResource Border/Default}"/>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Загрузить список из базы" Click="ReloadRemote_Click"/>
                            <Button Content="Выбрать все" Click="SelectAllRemote_Click"/>
                            <Button Content="Снять выделение" Click="ClearRemote_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ImportButton" Content="Импортировать выбранное" Style="{StaticResource PrimaryButtonStyle}" Click="Import_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,340,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RetryAssetsButton" Content="Повторить перенос изображений" Click="RetryAssets_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button Content="Закрыть" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
