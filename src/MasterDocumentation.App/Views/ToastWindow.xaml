<Window x:Class="MasterDocumentation.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MasterDocumentation.Views"
        Title="Уведомления MasterDocumentation"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True">
    <views:ToastHost x:Name="Notifications" Margin="16"/>
</Window>
