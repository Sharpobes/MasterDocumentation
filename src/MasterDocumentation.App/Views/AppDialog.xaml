<Window x:Class="MasterDocumentation.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MasterDocumentation.UI"
        Title="MasterDocumentation"
        Width="500"
        MinWidth="420"
        MaxWidth="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource DialogWindowStyle}"
        AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource Self}}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="IconSurface" Width="34" Height="34" VerticalAlignment="Top" Background="{DynamicResource State/InfoSoft}" CornerRadius="17">
                <ui:AppIcon x:Name="DialogIcon" Kind="Info" Width="19" Height="19" Foreground="{DynamicResource State/Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       MinHeight="34"
                       MaxWidth="620"
                       Foreground="{DynamicResource Text/Primary}"
                       FontSize="14"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
        </Grid>
        <StackPanel x:Name="ButtonsPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0"/>
    </Grid>
</Window>
