<UserControl x:Class="MasterDocumentation.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MasterDocumentation.UI" Background="{DynamicResource Background/App}" Foreground="{DynamicResource Text/Primary}" SizeChanged="SettingsView_SizeChanged">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Background/SurfaceElevated}"/><Setter Property="BorderBrush" Value="{DynamicResource Border/Subtle}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="Padding" Value="16,11"/><Setter Property="BorderBrush" Value="{DynamicResource Border/Subtle}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Height" Value="58"/><Setter Property="Margin" Value="5,2"/><Setter Property="Padding" Value="10,5"/></Style>
  <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="44" Height="24"><Border x:Name="Track" Background="{DynamicResource Background/Pressed}" BorderBrush="{DynamicResource Border/Strong}" BorderThickness="1" CornerRadius="12"/><Ellipse x:Name="Knob" Width="18" Height="18" Margin="3" HorizontalAlignment="Left" Fill="{DynamicResource Text/Secondary}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Border/Focus}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Border/Focus}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent/Primary}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent/Hover}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Text/OnAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid x:Name="SettingsRoot" Margin="5,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsNavigationColumn" Width="225"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsAsideGapColumn" Width="8"/><ColumnDefinition x:Name="SettingsAsideColumn" Width="285"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource Background/Surface}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <Grid Margin="12,8"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid Grid.Row="1"><TextBox x:Name="SettingsSearchBox" AutomationProperties.Name="Поиск настроек" ToolTip="Поиск по категориям настроек" TextChanged="SettingsSearch_TextChanged" Padding="10,6"/><TextBlock Text="Поиск настроек" Margin="11,0" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SettingsSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsNavigationItems" Margin="5,4">
     <Button Style="{StaticResource Nav}" Tag="0" Click="General_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="Settings" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Общие" FontSize="15"/><TextBlock Text="Язык, запуск, недавние файлы" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
     <Button Style="{StaticResource Nav}" Tag="1" Click="Storage_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="Storage" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Хранение" FontSize="15"/><TextBlock Text="Пути, база данных, копии" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
     <Button Style="{StaticResource Nav}" Tag="2" Click="EditorSettings_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="Properties" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Редактор" FontSize="15"/><TextBlock Text="Шрифты, сохранение, проверка" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
     <Button Style="{StaticResource Nav}" Tag="3" Click="Interface_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="App" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Интерфейс" FontSize="15"/><TextBlock Text="Тема и плотность элементов" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
     <Button Style="{StaticResource Nav}" Tag="4" Click="Documents_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="Documents" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Документы и экспорт" FontSize="15"/><TextBlock Text="Экспорт, изображения, версии" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
     <Button Style="{StaticResource Nav}" Tag="5" Click="Hotkeys_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="Code" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Горячие клавиши" FontSize="15"/><TextBlock Text="Сочетания клавиш" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
     <Button Style="{StaticResource Nav}" Tag="6" Click="Security_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="Success" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Безопасность" FontSize="15"/><TextBlock Text="Данные и шифрование" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
     <Button Style="{StaticResource Nav}" Tag="7" Click="About_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:AppIcon Kind="Info" Width="18" Height="18" Foreground="{DynamicResource Text/Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="О программе" FontSize="15"/><TextBlock Text="Версия и журналы" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel></Grid></Button>
   </StackPanel></ScrollViewer>
   <Button Grid.Row="2" Content="↻  Сбросить настройки" Margin="12" HorizontalContentAlignment="Center" Click="Reset_Click"/>
  </Grid></Border>

  <Border Grid.Column="2" Background="{DynamicResource Background/Surface}" BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
   <Grid Margin="20,0"><TextBlock x:Name="SectionTitle" Text="Общие" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><!-- Padding="0": общий отступ кнопок (12 слева и справа) не оставлял места значку, и крестик обрезался. --><Button Width="32" Height="32" MinHeight="32" Padding="0" HorizontalAlignment="Right" ToolTip="Закрыть настройки" Click="Cancel_Click"><ui:AppIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource Text/Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid>
   <Grid Grid.Row="1" Margin="20,0,20,4">
    <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◎  Язык интерфейса"/><TextBlock Text="Язык меню и системных сообщений" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel><ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="Language_Changed"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></Grid></Border>
       <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="◷  Поведение при запуске" TextTrimming="CharacterEllipsis"/><TextBlock Text="Что открывать после запуска" FontSize="11" Foreground="{DynamicResource Text/Muted}" TextTrimming="CharacterEllipsis"/></StackPanel><ComboBox x:Name="StartupBox" Grid.Column="1" SelectionChanged="Control_Changed"><ComboBoxItem Content="Открывать последнюю сессию"/><ComboBoxItem Content="Открывать стартовую страницу"/><ComboBoxItem Content="Открывать пустое окно"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◷  Количество недавних файлов"/><TextBlock Text="От 1 до 100 документов" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="−" Click="RecentMinus_Click"/><TextBlock x:Name="RecentCountText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" Content="＋" Click="RecentPlus_Click"/></Grid></Grid></Border>
      <Border Padding="16,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◉  Компактный режим"/><TextBlock Text="Уменьшает внутренние отступы" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel><CheckBox x:Name="CompactCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
     </StackPanel></Border>
     <TextBlock Text="Дополнительно" FontWeight="SemiBold" Margin="2,4,0,10"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◉  Проверять обновления автоматически"/><TextBlock Text="Только уведомление о новых версиях" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel><CheckBox x:Name="UpdatesCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="☏  Показывать подсказки"/><TextBlock Text="Контекстные подсказки в интерфейсе" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel><CheckBox x:Name="TooltipsCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◇  Подтверждать удаление документов"/><TextBlock Text="Показывать диалог подтверждения" FontSize="11" Foreground="{DynamicResource Text/Muted}"/></StackPanel><CheckBox x:Name="ConfirmDeleteCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="◎  Открывать ссылки во" VerticalAlignment="Center"/><ComboBox x:Name="LinkBox" Grid.Column="1" SelectionChanged="Control_Changed"><ComboBoxItem Content="Во встроенном браузере"/><ComboBoxItem Content="В системном браузере"/></ComboBox></Grid></Border>
      <Border Padding="16,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="◉  Единицы измерения" VerticalAlignment="Center"/><ComboBox x:Name="UnitsBox" Grid.Column="1" SelectionChanged="Control_Changed"><ComboBoxItem Content="Миллиметры (мм)"/><ComboBoxItem Content="Дюймы"/><ComboBoxItem Content="Пиксели"/></ComboBox></Grid></Border>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="StoragePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Папка данных" Foreground="{DynamicResource Text/Muted}"/><TextBox x:Name="DataPathBox" IsReadOnly="True" Margin="0,7,0,10"/><WrapPanel><Button Content="Изменить папку…" Click="ChangeDataPath_Click"/><Button Content="Открыть папку" Click="OpenData_Click"/><Button Content="Проверить базу" Click="CheckDatabase_Click"/></WrapPanel><TextBlock Text="При переносе данные сначала копируются во временную папку и проверяются. Старое хранилище не удаляется автоматически." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="Обслуживание" Foreground="{DynamicResource Text/Muted}" Margin="0,22,0,6"/><WrapPanel><Button Content="Перестроить поисковый индекс" Click="RebuildIndex_Click"/><Button Content="Очистить неиспользуемые файлы" Click="CleanupAssets_Click"/></WrapPanel><TextBlock Text="Папка вложений" Foreground="{DynamicResource Text/Muted}" Margin="0,22,0,5"/><TextBlock x:Name="AssetsPathText" TextWrapping="Wrap"/><TextBlock Text="Резервные копии" Foreground="{DynamicResource Text/Muted}" Margin="0,22,0,5"/><TextBlock x:Name="BackupsPathText" TextWrapping="Wrap"/>
     <TextBlock Text="База данных" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,10"/>
     <TextBlock Text="По умолчанию документация хранится локально в файле SQLite. Можно переключиться на внешнюю БД PostgreSQL — приложение продолжит работать так же, изменится только место хранения." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <RadioButton x:Name="StorageProviderSqliteRadio" Content="SQLite (локальный файл, по умолчанию)" GroupName="StorageProvider" IsChecked="True" Checked="StorageProvider_Changed" Margin="0,0,0,8"/>
     <RadioButton x:Name="StorageProviderPostgresRadio" Content="PostgreSQL" GroupName="StorageProvider" Checked="StorageProvider_Changed" Margin="0,0,0,8"/>
     <StackPanel x:Name="PostgresConfigPanel" Visibility="Collapsed" Margin="20,4,0,0">
      <TextBlock Text="Строка подключения (Npgsql), например: Host=localhost;Port=5432;Database=masterdocumentation;Username=postgres;Password=***" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,0,0,7"/>
      <TextBox x:Name="PostgresConnectionStringBox" TextChanged="Control_Changed" Margin="0,0,0,10"/>
      <WrapPanel>
       <Button x:Name="TestConnectionButton" Content="Проверить соединение" Click="TestConnection_Click"/>
       <Button x:Name="MigrateToPostgresButton" Content="Перенести текущие данные в PostgreSQL" Click="MigrateToPostgres_Click" Margin="8,0,0,0"/>
      </WrapPanel>
      <TextBlock x:Name="StorageProviderStatusText" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
     <TextBlock Text="Выбор провайдера применяется после сохранения и перезапуска приложения." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
     <TextBlock Text="Имя пользователя базы данных" Foreground="{DynamicResource Text/Muted}" Margin="0,22,0,6"/>
     <TextBox x:Name="StorageUserBox" TextChanged="Control_Changed"/>
     <TextBlock Text="Под этим именем страницы помечаются как ваши. Приватные страницы видит только их владелец, остальные доступны всем, кто подключился к этой базе через приложение." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
     <TextBlock Text="Импорт и выгрузка документации" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,8"/>
     <TextBlock Text="Отдельное окно позволяет выбрать, какие именно локально сохранённые страницы записать в базу данных, и какие страницы забрать из базы в текущее хранилище. Изображения переносятся вместе со страницами." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <Button Content="Открыть окно обмена с базой данных…" HorizontalAlignment="Left" Click="DatabaseTransfer_Click"/>
     <TextBlock Text="Страницы документации" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,8"/>
     <TextBlock Text="Каждая страница дополнительно сохраняется на диск в формате Markdown (.md) — их можно читать и версионировать без приложения." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="DocumentsPathText" TextWrapping="Wrap"/>
     <Button Content="Открыть папку .md-файлов" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenDocuments_Click"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Шрифт по умолчанию" Margin="0,0,0,6"/><ComboBox x:Name="DefaultFontBox" SelectionChanged="Control_Changed"/><TextBlock Text="Размер шрифта" Margin="0,18,0,6"/><TextBox x:Name="DefaultFontSizeBox" TextChanged="Control_Changed"/><CheckBox x:Name="SpellCheckBox" Content="Проверка орфографии" Margin="0,18" Checked="Control_Changed" Unchecked="Control_Changed"/><TextBlock Text="Задержка автосохранения, секунд"/><TextBox x:Name="AutoSaveDelayBox" Margin="0,6,0,0" TextChanged="Control_Changed"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="InterfacePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Тема приложения" Margin="0,0,0,6"/><ComboBox x:Name="ThemeBox" SelectionChanged="Control_Changed"><ComboBoxItem Content="Системная"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/></ComboBox><TextBlock Text="Изменение темы применяется после сохранения." Foreground="{DynamicResource Text/Muted}" Margin="0,10"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="DocumentsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Папка экспорта" Margin="0,0,0,6"/><TextBlock x:Name="ExportsPathText" TextWrapping="Wrap"/><Button Content="Открыть папку экспорта" HorizontalAlignment="Left" Margin="0,12" Click="OpenExports_Click"/><TextBlock Text="Форматы экспорта: PDF, DOCX, HTML, Markdown и обычный текст." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <Grid x:Name="HotkeysPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="HotkeysGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource Background/App}" Foreground="{DynamicResource Text/Primary}" BorderBrush="{DynamicResource Border/Default}" RowBackground="{DynamicResource Background/Surface}" AlternatingRowBackground="{DynamicResource Background/SurfaceElevated}" CellEditEnding="HotkeysGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="Команда" Binding="{Binding Command}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Сочетание" Binding="{Binding Gesture,UpdateSourceTrigger=PropertyChanged}" Width="145"/><DataGridTextColumn Header="Категория" Binding="{Binding Category}" IsReadOnly="True" Width="130"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="Сбросить сочетания" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetHotkeys_Click"/></Grid>
     <ScrollViewer x:Name="SecurityPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><CheckBox x:Name="EncryptionCheck" Content="Шифровать ручные резервные копии AES-256-GCM" Checked="Control_Changed" Unchecked="Control_Changed"/><TextBlock Text="Пароль запрашивается при создании каждой копии и нигде не сохраняется." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,10,0,24"/><TextBlock Text="Телеметрия отсутствует" Foreground="{DynamicResource State/Success}"/><TextBlock Text="Облачная синхронизация отсутствует" Foreground="{DynamicResource State/Success}" Margin="0,9"/><TextBlock Text="Данные не покидают компьютер" Foreground="{DynamicResource State/Success}"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="MasterDocumentation" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeText" Margin="0,18,0,6"/><TextBlock x:Name="AppPathText" TextWrapping="Wrap"/><Button Content="Открыть папку журналов" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenLogs_Click"/></StackPanel></ScrollViewer>
   </Grid>
    <!-- «Применить» сохраняет настройки и оставляет пользователя в них, «Сохранить» — сохраняет и закрывает. -->
    <Grid Grid.Row="2" Margin="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ApplyButton" Content="Применить" Width="135" IsEnabled="False" Click="Apply_Click" ToolTip="Сохранить настройки и остаться на этой вкладке"/><Button x:Name="SaveButton" Content="Сохранить" Width="145" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" ToolTip="Сохранить настройки и закрыть вкладку"/><Button Content="Отмена" Width="120" Click="Cancel_Click"/></StackPanel></Grid>
  </Grid></Border>

  <ScrollViewer x:Name="SettingsAside" Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="◇  Ваши данные остаются на вашем компьютере" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="MasterDocumentation — локальное приложение. Файлы не передаются в облако." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,10,0,18"/><TextBlock Text="◉  100% локально"/><TextBlock Text="♧  Без облачной синхронизации" Margin="0,10"/><TextBlock Text="⊘  Без сбора телеметрии"/><Button Content="▱  Открыть папку данных" Margin="0,18,0,0" Click="OpenData_Click"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Текущее хранилище" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="StoragePathText" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock x:Name="StorageStatsText" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap"/><ProgressBar x:Name="DiskUsageBar" Margin="0,12,0,0" Maximum="100"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Быстрое резервное копирование" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Создайте резервную копию всех локальных данных." Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,10"/><Button Content="⇧  Создать резервную копию" Click="QuickBackup_Click"/><TextBlock x:Name="LastBackupText" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
