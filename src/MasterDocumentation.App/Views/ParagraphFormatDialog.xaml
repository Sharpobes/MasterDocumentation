<Window x:Class="MasterDocumentation.Views.ParagraphFormatDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Параметры абзаца" Width="470" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindowStyle}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Параметры абзаца" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Значения указываются в пикселях. Пустое поле сбрасывает прямую настройку." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,16"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock Text="Интервал перед абзацем" VerticalAlignment="Center"/><TextBox x:Name="BeforeBox" Grid.Column="1" Margin="0,5"/>
   <TextBlock Grid.Row="1" Text="Интервал после абзаца" VerticalAlignment="Center"/><TextBox x:Name="AfterBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
   <TextBlock Grid.Row="2" Text="Отступ первой строки" VerticalAlignment="Center"/><TextBox x:Name="FirstIndentBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
   <TextBlock Grid.Row="3" Text="Левый отступ" VerticalAlignment="Center"/><TextBox x:Name="LeftIndentBox" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
   <TextBlock Grid.Row="4" Text="Правый отступ" VerticalAlignment="Center"/><TextBox x:Name="RightIndentBox" Grid.Row="4" Grid.Column="1" Margin="0,5"/>
   <TextBlock Grid.Row="5" Text="Направление текста" VerticalAlignment="Center"/><ComboBox x:Name="DirectionBox" Grid.Row="5" Grid.Column="1" Margin="0,5"><ComboBoxItem Content="Автоматически" Tag=""/><ComboBoxItem Content="Слева направо" Tag="ltr"/><ComboBoxItem Content="Справа налево" Tag="rtl"/></ComboBox>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Button Content="Сбросить" HorizontalAlignment="Left" Click="Reset_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True"/><Button Content="Применить" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click"/></StackPanel></Grid>
 </Grid>
</Window>
