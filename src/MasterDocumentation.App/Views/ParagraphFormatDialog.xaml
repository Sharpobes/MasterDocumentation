<Window x:Class="MasterDocumentation.Views.ParagraphFormatDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Параметры абзаца" Width="620" SizeToContent="Height" MinHeight="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindowStyle}" Background="{DynamicResource Background/Surface}" Foreground="{DynamicResource Text/Primary}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Параметры абзаца" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="UnitsHintText" Foreground="{DynamicResource Text/Muted}" TextWrapping="Wrap" Margin="0,6,0,18"/></StackPanel>
  <!-- Три колонки: подпись, поле и единица измерения. Единицы берутся из настроек приложения,
       поэтому в полях не остаётся «голых пикселей», непонятных при вёрстке документа. -->
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="230"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto" MinWidth="62"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Интервал перед абзацем" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="BeforeBox" Grid.Column="1" Margin="0,6"/><TextBlock x:Name="BeforeUnit" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Text/Muted}"/>
   <TextBlock Grid.Row="1" Text="Интервал после абзаца" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="AfterBox" Grid.Row="1" Grid.Column="1" Margin="0,6"/><TextBlock x:Name="AfterUnit" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Text/Muted}"/>
   <TextBlock Grid.Row="2" Text="Отступ первой строки" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="FirstIndentBox" Grid.Row="2" Grid.Column="1" Margin="0,6"/><TextBlock x:Name="FirstIndentUnit" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Text/Muted}"/>
   <TextBlock Grid.Row="3" Text="Левый отступ" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="LeftIndentBox" Grid.Row="3" Grid.Column="1" Margin="0,6"/><TextBlock x:Name="LeftIndentUnit" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Text/Muted}"/>
   <TextBlock Grid.Row="4" Text="Правый отступ" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="RightIndentBox" Grid.Row="4" Grid.Column="1" Margin="0,6"/><TextBlock x:Name="RightIndentUnit" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Text/Muted}"/>
   <TextBlock Grid.Row="5" Text="Направление текста" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="DirectionBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6"><ComboBoxItem Content="Автоматически" Tag=""/><ComboBoxItem Content="Слева направо" Tag="ltr"/><ComboBoxItem Content="Справа налево" Tag="rtl"/></ComboBox>
  </Grid>
  <Grid Grid.Row="2" Margin="0,22,0,0"><Button Content="Вернуть значения по умолчанию" HorizontalAlignment="Left" Padding="14,7" Click="Reset_Click" ToolTip="Убрать прямые настройки абзаца и вернуться к оформлению документа"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" MinWidth="110"/><Button Content="Применить" IsDefault="True" MinWidth="130" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click"/></StackPanel></Grid>
 </Grid>
</Window>
