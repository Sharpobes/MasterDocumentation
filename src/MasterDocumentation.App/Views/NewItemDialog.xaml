<Window x:Class="MasterDocumentation.Views.NewItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание"
        Width="500"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background/App}"
        Foreground="{DynamicResource Text/Primary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Text="Создать документ" Style="{StaticResource Typography.PageTitle}" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="Название" Foreground="{DynamicResource Text/Secondary}"/>
        <TextBox x:Name="TitleBox" Grid.Row="2" Height="38" Margin="0,6,0,14" AutomationProperties.Name="Название"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Тип" Foreground="{DynamicResource Text/Secondary}"/>
                <Border Margin="0,6,0,0"
                        Height="36"
                        Background="{DynamicResource Background/SurfaceElevated}"
                        BorderBrush="{DynamicResource Border/Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Small}"
                        Padding="10,0">
                    <TextBlock x:Name="KindText" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Расположение" Foreground="{DynamicResource Text/Secondary}"/>
                <ComboBox x:Name="ParentBox" Margin="0,6,0,0" DisplayMemberPath="Name" AutomationProperties.Name="Расположение"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="TemplatePanel" Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Создать из шаблона" Foreground="{DynamicResource Text/Secondary}"/>
            <ComboBox x:Name="TemplateBox" Margin="0,6,0,0" DisplayMemberPath="Title" AutomationProperties.Name="Шаблон"/>
            <TextBlock Text="Шаблон копирует содержимое и форматирование, но создаёт независимый документ."
                       Foreground="{DynamicResource Text/Muted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True"/>
            <Button Content="Создать" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
