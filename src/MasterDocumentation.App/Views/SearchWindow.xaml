<Window x:Class="MasterDocumentation.Views.SearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Глобальный поиск" Width="920" Height="650" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="QueryBox" Height="40" Padding="11,7" TextChanged="Filter_Changed" ToolTip="Слова или точная фраза в кавычках"/><Button Grid.Column="1" Content="Найти" IsDefault="True" Click="Search_Click"/></Grid>
  <WrapPanel Grid.Row="1" Margin="0,10"><ComboBox x:Name="StatusBox" Width="155" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Все статусы" IsSelected="True"/><ComboBoxItem Content="Черновик"/><ComboBoxItem Content="В работе"/><ComboBoxItem Content="На проверке"/><ComboBoxItem Content="Завершён"/><ComboBoxItem Content="Архив"/></ComboBox><TextBox x:Name="TagBox" Width="150" Margin="5" Padding="8,5" ToolTip="Точный тег" TextChanged="Filter_Changed"/><CheckBox x:Name="FavoritesBox" Content="Только избранное" VerticalAlignment="Center" Margin="10,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/><CheckBox x:Name="AttachmentsBox" Content="С вложениями" VerticalAlignment="Center" Margin="10,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/><CheckBox x:Name="TrashBox" Content="Искать в корзине" VerticalAlignment="Center" Margin="10,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/><ComboBox x:Name="SortBox" Width="145" SelectionChanged="Filter_Changed"><ComboBoxItem Content="По релевантности" IsSelected="True"/><ComboBoxItem Content="По дате"/></ComboBox></WrapPanel>
  <ListView x:Name="ResultsList" Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" MouseDoubleClick="Results_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{Binding Status}"/><Run Text="  •  "/><Run Text="{Binding ModifiedAt,StringFormat={}{0:dd.MM.yyyy HH:mm}}"/></TextBlock></Grid><TextBlock Grid.Row="1" Text="{Binding Snippet}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="46" Margin="0,5,0,0"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
  <Grid Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="ResultCountText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Закрыть" IsCancel="True"/><Button Content="Открыть документ" Click="Open_Click"/></StackPanel></Grid>
 </Grid>
</Window>
