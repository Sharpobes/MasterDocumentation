<Window x:Class="MasterDocumentation.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск и команды"
        Width="920"
        Height="650"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background/App}"
        Foreground="{DynamicResource Text/Primary}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,12">
            <TextBlock Text="Поиск и команды" Style="{StaticResource Typography.PageTitle}"/>
            <TextBlock Text="Найдите документ или запустите действие. Для команд можно вводить «создать», «экспорт», «тема»."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Text/Secondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox"
                     AutomationProperties.Name="Запрос поиска"
                     Height="40"
                     Padding="11,7"
                     TextChanged="Filter_Changed"
                     ToolTip="Документ, текст или команда"/>
            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Content="Найти"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Search_Click"/>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,10">
            <ComboBox x:Name="StatusBox" Width="155" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                <ComboBoxItem Content="Черновик"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="На проверке"/>
                <ComboBoxItem Content="Завершён"/>
                <ComboBoxItem Content="Архив"/>
            </ComboBox>
            <TextBox x:Name="TagBox" AutomationProperties.Name="Фильтр по тегу" Width="150" Margin="5" Padding="8,5" ToolTip="Точный тег" TextChanged="Filter_Changed"/>
            <CheckBox x:Name="FavoritesBox" Content="Только избранное" VerticalAlignment="Center" Margin="10,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="AttachmentsBox" Content="С вложениями" VerticalAlignment="Center" Margin="10,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="TrashBox" Content="Искать в корзине" VerticalAlignment="Center" Margin="10,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Width="145" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="По релевантности" IsSelected="True"/>
                <ComboBoxItem Content="По дате"/>
            </ComboBox>
        </WrapPanel>

        <Grid Grid.Row="3">
            <ListView x:Name="ResultsList"
                      AutomationProperties.Name="Результаты поиска и команды"
                      Background="{DynamicResource Background/Surface}"
                      BorderBrush="{DynamicResource Border/Default}"
                      MouseDoubleClick="Results_DoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Border/Subtle}" BorderThickness="0,0,0,1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Meta}" Foreground="{DynamicResource Text/Muted}" Margin="12,0,0,0"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Snippet}"
                                           Foreground="{DynamicResource Text/Secondary}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="46"
                                           Margin="0,5,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border x:Name="EmptyState"
                    Visibility="Collapsed"
                    Margin="1"
                    Background="{DynamicResource Background/Surface}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                    <TextBlock x:Name="EmptyTitle" Text="Ничего не найдено" Style="{StaticResource Typography.SectionTitle}" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyDescription" Text="Измените запрос или снимите часть фильтров."
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource Text/Secondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button x:Name="RebuildIndexButton" Content="Перестроить поисковый индекс" Visibility="Collapsed" Margin="0,12,0,0" Click="RebuildIndex_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="ResultCountText" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Закрыть" IsCancel="True"/>
                <Button x:Name="OpenButton" Content="Открыть / выполнить" Style="{StaticResource PrimaryButtonStyle}" Click="Open_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
