<Window x:Class="MasterDocumentation.Views.NotificationCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MasterDocumentation.UI"
        Title="Уведомления"
        Width="404"
        Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True">
    <Border Background="{DynamicResource Background/SurfaceElevated}"
            BorderBrush="{DynamicResource Border/Strong}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Medium}"
            Effect="{StaticResource Shadow.Popup}">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Уведомления" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Очистить" Click="Clear_Click" AutomationProperties.Name="Очистить уведомления"/>
            </Grid>

            <TextBlock x:Name="EmptyText"
                       Grid.Row="1"
                       Text="Уведомлений пока нет"
                       Foreground="{DynamicResource Text/Muted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="11,9"
                                    Background="{DynamicResource Background/Surface}"
                                    BorderBrush="{DynamicResource Border/Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Small}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ui:AppIcon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding Accent}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Message}" Margin="0,3,0,0" Foreground="{DynamicResource Text/Secondary}" TextWrapping="Wrap" MaxHeight="66"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Top" Margin="8,1,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{Binding PrimaryActionText}"
                                                Visibility="{Binding HasPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="PrimaryAction_Click"
                                                AutomationProperties.Name="{Binding PrimaryActionText}"/>
                                        <Button Content="{Binding SecondaryActionText}"
                                                Visibility="{Binding HasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="SecondaryAction_Click"
                                                AutomationProperties.Name="{Binding SecondaryActionText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
