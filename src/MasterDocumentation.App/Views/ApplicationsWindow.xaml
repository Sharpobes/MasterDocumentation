<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MasterDocumentation.Views.ApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:MasterDocumentation.UI"
        Title="Приложения и инструменты" Width="650" Height="430" MinWidth="520" MinHeight="360"
        Style="{x:Null}" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background/App}" Foreground="{DynamicResource Text/Primary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Border/Default}" BorderThickness="1" Background="{DynamicResource Background/App}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Border/Default}" BorderThickness="0,0,0,1" Background="{DynamicResource Background/SurfaceElevated}">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource Accent/Primary}" VerticalAlignment="Center">
                        <ui:AppIcon Kind="Apps" Width="13" Height="13" Foreground="{DynamicResource Text/OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Приложения и инструменты" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text/Primary}" Margin="10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="×" ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть окно"
                            IsCancel="True" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Приложения" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Text/Primary}" />
                    <TextBlock Text="Локальные инструменты, полезные при подготовке документации."
                               Foreground="{DynamicResource Text/Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                    <Button Margin="0,0,10,10" Padding="14,12" HorizontalContentAlignment="Left"
                            Click="Snipping_Click" ToolTip="Открыть системный инструмент захвата экрана (Ножницы)"
                            AutomationProperties.Name="Ножницы — сделать снимок экрана">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Accent/Soft}" VerticalAlignment="Top">
                                <ui:AppIcon Kind="Crop" Width="18" Height="18" Foreground="{DynamicResource Accent/Hover}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ножницы" FontWeight="SemiBold" Foreground="{DynamicResource Text/Primary}" />
                                <TextBlock Text="Сделать снимок экрана" Foreground="{DynamicResource Text/Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,0,10" Padding="14,12" HorizontalContentAlignment="Left"
                            Click="Paint_Click" ToolTip="Открыть Paint для обработки изображения"
                            AutomationProperties.Name="Paint — обработать изображение">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Accent/Soft}" VerticalAlignment="Top">
                                <ui:AppIcon Kind="Image" Width="18" Height="18" Foreground="{DynamicResource Accent/Hover}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Paint" FontWeight="SemiBold" Foreground="{DynamicResource Text/Primary}" />
                                <TextBlock Text="Обработать изображение" Foreground="{DynamicResource Text/Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,10,0" Padding="14,12" HorizontalContentAlignment="Left"
                            Click="Calculator_Click" ToolTip="Открыть Калькулятор Windows"
                            AutomationProperties.Name="Калькулятор">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Accent/Soft}" VerticalAlignment="Top">
                                <ui:AppIcon Kind="Calculator" Width="18" Height="18" Foreground="{DynamicResource Accent/Hover}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Калькулятор" FontWeight="SemiBold" Foreground="{DynamicResource Text/Primary}" />
                                <TextBlock Text="Быстрые вычисления" Foreground="{DynamicResource Text/Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,0,0" Padding="14,12" HorizontalContentAlignment="Left"
                            Click="Assets_Click" ToolTip="Открыть папку вложений текущего хранилища в проводнике"
                            AutomationProperties.Name="Открыть папку вложений">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Accent/Soft}" VerticalAlignment="Top">
                                <ui:AppIcon Kind="OpenFolder" Width="18" Height="18" Foreground="{DynamicResource Accent/Hover}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Папка вложений" FontWeight="SemiBold" Foreground="{DynamicResource Text/Primary}" />
                                <TextBlock Text="Открыть в проводнике" Foreground="{DynamicResource Text/Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
