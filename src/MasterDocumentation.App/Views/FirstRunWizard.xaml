<Window x:Class="MasterDocumentation.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MasterDocumentation.UI"
        Title="Первый запуск — MasterDocumentation"
        Width="720"
        Height="680"
        MinWidth="650"
        MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background/App}"
        Foreground="{DynamicResource Text/Primary}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="{StaticResource Radius.Medium}" Background="{DynamicResource Accent/Primary}">
                <ui:AppIcon Kind="App" Width="24" Height="24" Foreground="{DynamicResource Text/OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0">
                <TextBlock Text="Добро пожаловать в MasterDocumentation" Style="{StaticResource Typography.PageTitle}"/>
                <TextBlock Text="Подготовим полностью локальное хранилище. Эти параметры можно изменить позже."
                           Foreground="{DynamicResource Text/Secondary}"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,18">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,13">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Язык интерфейса" Style="{StaticResource Typography.SectionTitle}"/>
                            <TextBlock Text="Язык меню и сообщений приложения" Foreground="{DynamicResource Text/Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Русский"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="Папка локальных данных" Style="{StaticResource Typography.SectionTitle}"/>
                        <TextBlock Text="База, документы, вложения и резервные копии будут находиться здесь." Foreground="{DynamicResource Text/Muted}" Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="DataPathBox" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Выбрать…" Click="Browse_Click"/>
                        </Grid>
                        <TextBlock Text="Приложение не использует облако и не отправляет телеметрию." Foreground="{DynamicResource State/Success}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,13">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Тема" Style="{StaticResource Typography.SectionTitle}"/>
                            <TextBlock Text="Системная тема следует настройкам Windows" Foreground="{DynamicResource Text/Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedIndex="2">
                            <ComboBoxItem Content="Системная"/>
                            <ComboBoxItem Content="Светлая"/>
                            <ComboBoxItem Content="Тёмная"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <CheckBox x:Name="AutomaticBackupsCheck" Content="Создавать автоматические резервные копии" IsChecked="True"/>
                        <CheckBox x:Name="CreateDocumentCheck" Content="Создать первый документ" IsChecked="True" Margin="0,13,0,7" Checked="CreateDocument_Changed" Unchecked="CreateDocument_Changed"/>
                        <TextBox x:Name="FirstDocumentBox" Text="Мой первый документ" Margin="22,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock Text="Все параметры хранятся локально в settings.json" Foreground="{DynamicResource Text/Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Пропустить" Click="Skip_Click"/>
                <Button Content="Начать работу" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Finish_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
