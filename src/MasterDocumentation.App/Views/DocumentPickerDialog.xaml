<Window x:Class="MasterDocumentation.Views.DocumentPickerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ссылка на документ" Width="540" Height="560" MinWidth="420" MinHeight="400" WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindowStyle}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Выберите документ" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBox x:Name="SearchBox" Grid.Row="1" Height="38" Padding="10,6" TextChanged="Search_Changed" ToolTip="Фильтр по названию"/>
  <ListBox x:Name="DocumentsList" Grid.Row="2" Margin="0,12" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" MouseDoubleClick="Documents_DoubleClick" DisplayMemberPath="Display"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True"/><Button Content="Вставить ссылку" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Select_Click"/></StackPanel>
 </Grid>
</Window>
