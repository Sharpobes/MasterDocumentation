<Window x:Class="MasterDocumentation.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка MasterDocumentation"
        Width="760"
        Height="660"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource Surface.App}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Accent}" VerticalAlignment="Top">
                    <TextBlock Text="MD" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="MasterDocumentation" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="Локальная документация без облака и регистрации" Foreground="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Шаг 1: параметры установки -->
        <ScrollViewer x:Name="OptionsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel>
                <TextBlock Text="Как установить приложение" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Border Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                    <StackPanel>
                        <RadioButton x:Name="InstallModeRadio" GroupName="Mode" IsChecked="True" Checked="Mode_Changed" AutomationProperties.Name="Установить на компьютер">
                            <StackPanel>
                                <TextBlock Text="Установить на компьютер" FontWeight="SemiBold"/>
                                <TextBlock Text="Ярлыки на рабочем столе и в меню «Пуск», запись в «Программы и компоненты» для удаления. Документация хранится в профиле пользователя и переживает обновление."
                                           Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <RadioButton x:Name="PortableModeRadio" GroupName="Mode" Checked="Mode_Changed" AutomationProperties.Name="Портативная версия">
                            <StackPanel>
                                <TextBlock Text="Портативная версия" FontWeight="SemiBold"/>
                                <TextBlock Text="Всё приложение и папка Data лежат в одной папке — её можно перенести на флешку или другой компьютер. Система не изменяется, записи в реестр не создаются."
                                           Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <TextBlock Text="Папка" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" AutomationProperties.Name="Папка установки"/>
                    <Button Grid.Column="1" Content="Обзор…" MinWidth="110" Click="Browse_Click"/>
                </Grid>
                <TextBlock x:Name="SpaceText" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,0,0,16"/>

                <TextBlock Text="Дополнительно" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="DesktopShortcutCheck" Content="Создать ярлык на рабочем столе" IsChecked="True"/>
                <CheckBox x:Name="StartMenuShortcutCheck" Content="Добавить в меню «Пуск»" IsChecked="True"/>
                <CheckBox x:Name="LaunchCheck" Content="Запустить MasterDocumentation сразу после установки" IsChecked="True"/>
                <TextBlock Text="Если снять галочку, запустить приложение можно будет кнопкой на последнем шаге." Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="24,0,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Шаг 2: ход установки -->
        <Grid x:Name="ProgressPanel" Grid.Row="1" Margin="28,22" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Идёт установка" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="ProgressText" Text="Подготовка…" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,14"/>
                <ProgressBar x:Name="ProgressBarControl" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="{StaticResource Surface.Elevated}" BorderThickness="0"/>
                <TextBlock Text="Приложение занимает около 700 МБ: в комплект входят собственный движок редактора и все библиотеки, поэтому ничего доустанавливать не нужно."
                           Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Шаг 3: завершение -->
        <Grid x:Name="DonePanel" Grid.Row="1" Margin="28,22" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DoneTitle" Text="Установка завершена" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource State.Success}"/>
                <TextBlock x:Name="DoneText" Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,0"/>
                <StackPanel x:Name="DoneActions" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
                    <Button x:Name="LaunchNowButton" Content="Запустить MasterDocumentation" Style="{StaticResource PrimaryButton}" MinWidth="240" Margin="0" Click="LaunchNow_Click"/>
                    <Button Content="Открыть папку приложения" Click="OpenFolder_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Text.Muted}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click"/>
                    <Button x:Name="PrimaryButton" Content="Установить" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="Primary_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
