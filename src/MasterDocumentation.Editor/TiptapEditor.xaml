<UserControl x:Class="MasterDocumentation.Editor.TiptapEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"><Grid><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#121C27"/>
  <!-- Сообщение вместо редактора: без него сбой WebView2 выпадал общим окном ошибки приложения. -->
  <Border x:Name="FailurePanel" Visibility="Collapsed" Background="#121C27" Padding="32">
    <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Редактор не запустился" FontSize="18" FontWeight="SemiBold" Foreground="#E7EBF1"/>
      <TextBlock x:Name="FailureText" Margin="0,10,0,0" Foreground="#BCC6D3" TextWrapping="Wrap"/>
      <TextBlock Text="Обычно помогает перезапуск: компонент просмотра мог остаться занятым предыдущим запуском приложения." Margin="0,10,0,0" Foreground="#8E9AAA" TextWrapping="Wrap"/>
      <Button x:Name="RetryButton" Content="Повторить запуск редактора" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,8" Click="Retry_Click"/>
    </StackPanel>
  </Border>
</Grid></UserControl>
