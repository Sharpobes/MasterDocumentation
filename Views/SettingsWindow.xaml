<Window x:Class="MasterDocumentation.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Настройки — MasterDocumentation" Width="1420" Height="860" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#111820" Foreground="#D7DCE5" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D7DCE5"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#18212B"/><Setter Property="BorderBrush" Value="#303B49"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="BorderBrush" Value="#303B49"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="16,12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#F4F6F8"/><Setter Property="Foreground" Value="#20242A"/><Setter Property="BorderBrush" Value="#394655"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D7DCE5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#252F3C"/><Setter Property="Foreground" Value="#DFE4EB"/><Setter Property="BorderBrush" Value="#394655"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#252F3C"/><Setter Property="Foreground" Value="#D7DCE5"/><Setter Property="BorderBrush" Value="#394655"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="36"/></Style>
 </Window.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0"><TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="Все настройки хранятся локально" Foreground="#8E99A8" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="305"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8"><ListBox x:Name="Categories" Background="Transparent" BorderThickness="0" Foreground="#D7DCE5" SelectionChanged="Categories_SelectionChanged" SelectedIndex="0"><ListBoxItem Padding="12"><StackPanel><TextBlock Text="⚙  Общие" FontSize="16"/><TextBlock Text="     Язык, запуск, недавние файлы" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem><ListBoxItem Padding="12"><StackPanel><TextBlock Text="▣  Хранение" FontSize="16"/><TextBlock Text="     Пути, база данных, резервные копии" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem><ListBoxItem Padding="12"><StackPanel><TextBlock Text="✎  Редактор" FontSize="16"/><TextBlock Text="     Шрифты, форматирование, автосохранение" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem><ListBoxItem Padding="12"><StackPanel><TextBlock Text="▤  Интерфейс" FontSize="16"/><TextBlock Text="     Тема, внешний вид, поведение" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem><ListBoxItem Padding="12"><StackPanel><TextBlock Text="▧  Документы и экспорт" FontSize="16"/><TextBlock Text="     Экспорт, изображения, версии" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem><ListBoxItem Padding="12"><StackPanel><TextBlock Text="⌨  Горячие клавиши" FontSize="16"/><TextBlock Text="     Настройка сочетаний клавиш" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem><ListBoxItem Padding="12"><StackPanel><TextBlock Text="♢  Безопасность и приватность" FontSize="16"/><TextBlock Text="     Данные, пароли, подтверждения" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem><ListBoxItem Padding="12"><StackPanel><TextBlock Text="ⓘ  О программе" FontSize="16"/><TextBlock Text="     Версия, лицензия, обновления" Foreground="#929EAE" FontSize="12"/></StackPanel></ListBoxItem></ListBox></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><Grid>
    <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Общие" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><Border Style="{StaticResource Card}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><DockPanel><StackPanel><TextBlock Text="◎  Язык интерфейса"/><TextBlock Text="Язык меню и системных сообщений" Foreground="#8995A6" FontSize="12"/></StackPanel><ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="225" SelectionChanged="Control_Changed"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></DockPanel></Border>
     <Border Style="{StaticResource SettingRow}"><DockPanel><StackPanel><TextBlock Text="◷  Поведение при запуске"/><TextBlock Text="Что открывать после запуска приложения" Foreground="#8995A6" FontSize="12"/></StackPanel><ComboBox x:Name="StartupBox" DockPanel.Dock="Right" Width="280" SelectionChanged="Control_Changed"><ComboBoxItem Content="Открывать последнюю сессию"/><ComboBoxItem Content="Открывать стартовую страницу"/><ComboBoxItem Content="Открывать пустое окно"/></ComboBox></DockPanel></Border>
     <Border Style="{StaticResource SettingRow}"><DockPanel><StackPanel><TextBlock Text="◴  Количество недавних файлов"/><TextBlock Text="От 1 до 100 документов" Foreground="#8995A6" FontSize="12"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Click="RecentMinus_Click"/><TextBlock x:Name="RecentCountText" Width="38" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="＋" Click="RecentPlus_Click"/></StackPanel></DockPanel></Border>
     <Border Padding="16,12"><DockPanel><StackPanel><TextBlock Text="◉  Компактный режим"/><TextBlock Text="Уменьшает внутренние отступы элементов" Foreground="#8995A6" FontSize="12"/></StackPanel><CheckBox x:Name="CompactCheck" DockPanel.Dock="Right" Checked="Control_Changed" Unchecked="Control_Changed"/></DockPanel></Border>
    </StackPanel></Border>
    <TextBlock Text="Дополнительно" FontWeight="SemiBold" Margin="0,20,0,10"/><Border Style="{StaticResource Card}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><DockPanel><StackPanel><TextBlock Text="◉  Проверять обновления автоматически"/><TextBlock Text="Только уведомление о новых версиях" Foreground="#8995A6" FontSize="12"/></StackPanel><CheckBox x:Name="UpdatesCheck" DockPanel.Dock="Right" Checked="Control_Changed" Unchecked="Control_Changed"/></DockPanel></Border>
     <Border Style="{StaticResource SettingRow}"><DockPanel><StackPanel><TextBlock Text="☏  Показывать подсказки"/><TextBlock Text="Контекстные подсказки в интерфейсе" Foreground="#8995A6" FontSize="12"/></StackPanel><CheckBox x:Name="TooltipsCheck" DockPanel.Dock="Right" Checked="Control_Changed" Unchecked="Control_Changed"/></DockPanel></Border>
     <Border Style="{StaticResource SettingRow}"><DockPanel><StackPanel><TextBlock Text="♢  Подтверждать удаление документов"/><TextBlock Text="Показывать диалог подтверждения" Foreground="#8995A6" FontSize="12"/></StackPanel><CheckBox x:Name="ConfirmDeleteCheck" DockPanel.Dock="Right" Checked="Control_Changed" Unchecked="Control_Changed"/></DockPanel></Border>
     <Border Style="{StaticResource SettingRow}"><DockPanel><TextBlock Text="◎  Открывать ссылки во"/><ComboBox x:Name="LinkBox" DockPanel.Dock="Right" Width="225" SelectionChanged="Control_Changed"><ComboBoxItem Content="Во встроенном браузере"/><ComboBoxItem Content="В системном браузере"/></ComboBox></DockPanel></Border>
     <Border Padding="16,12"><DockPanel><TextBlock Text="◉  Единицы измерения"/><ComboBox x:Name="UnitsBox" DockPanel.Dock="Right" Width="225" SelectionChanged="Control_Changed"><ComboBoxItem Content="Миллиметры (мм)"/><ComboBoxItem Content="Дюймы"/><ComboBoxItem Content="Пиксели"/></ComboBox></DockPanel></Border>
    </StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="StoragePanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Хранение" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Текущая папка данных" Foreground="#929EAE" Margin="0,20,0,6"/><TextBox x:Name="DataPathBox" IsReadOnly="True"/><StackPanel Orientation="Horizontal" Margin="0,10"><Button Content="Открыть папку" Click="OpenData_Click"/><Button Content="Проверить целостность базы" Click="CheckDatabase_Click"/></StackPanel><TextBlock Text="Папка вложений" Foreground="#929EAE" Margin="0,16,0,6"/><TextBlock x:Name="AssetsPathText"/><TextBlock Text="Папка резервных копий" Foreground="#929EAE" Margin="0,16,0,6"/><TextBlock x:Name="BackupsPathText"/><Button Content="Создать резервную копию сейчас" Margin="0,22,0,0" Click="QuickBackup_Click"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Редактор" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Шрифт по умолчанию" Margin="0,22,0,6"/><ComboBox x:Name="DefaultFontBox" SelectionChanged="Control_Changed"/><TextBlock Text="Размер шрифта" Margin="0,16,0,6"/><TextBox x:Name="DefaultFontSizeBox" TextChanged="Control_Changed"/><CheckBox x:Name="SpellCheckBox" Content="Проверка орфографии" Margin="0,18" Checked="Control_Changed" Unchecked="Control_Changed"/><TextBlock Text="Задержка автосохранения, секунд"/><TextBox x:Name="AutoSaveDelayBox" TextChanged="Control_Changed"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="InterfacePanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Интерфейс" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Тема" Margin="0,22,0,6"/><ComboBox x:Name="ThemeBox" SelectionChanged="Control_Changed"><ComboBoxItem Content="Системная"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/></ComboBox><CheckBox Content="Компактный режим" IsChecked="{Binding IsChecked,ElementName=CompactCheck}" Margin="0,18"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ExportPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Документы и экспорт" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Папка экспорта" Margin="0,22,0,6"/><TextBlock Text="{Binding}"/><TextBlock x:Name="ExportsPathText"/><Button Content="Открыть папку экспорта" Click="OpenExports_Click" Margin="0,12,0,0"/></StackPanel></ScrollViewer>
    <Grid x:Name="HotkeysPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Горячие клавиши" FontSize="24" FontWeight="SemiBold"/><DataGrid x:Name="HotkeysGrid" Grid.Row="1" Margin="0,18,0,12" AutoGenerateColumns="False" CanUserAddRows="False" Background="#111820" Foreground="#D7DCE5" BorderBrush="#303B49" CellEditEnding="HotkeysGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="Команда" Binding="{Binding Command}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Сочетание" Binding="{Binding Gesture,UpdateSourceTrigger=PropertyChanged}" Width="150"/><DataGridTextColumn Header="Категория" Binding="{Binding Category}" IsReadOnly="True" Width="130"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Сбросить горячие клавиши" HorizontalAlignment="Left" Click="ResetHotkeys_Click"/></Grid>
    <ScrollViewer x:Name="SecurityPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Безопасность и приватность" FontSize="24" FontWeight="SemiBold"/><CheckBox Content="Подтверждать удаление документов" IsChecked="{Binding IsChecked,ElementName=ConfirmDeleteCheck}" Margin="0,22,0,12"/><CheckBox x:Name="EncryptionCheck" Content="Шифровать ручные резервные копии AES-256-GCM" Margin="0,0,0,18" Checked="Control_Changed" Unchecked="Control_Changed"/><TextBlock Text="Пароль запрашивается при каждом создании копии и не сохраняется." Foreground="#929EAE" TextWrapping="Wrap" Margin="0,0,0,18"/><TextBlock Text="Телеметрия отсутствует" Foreground="#54D78A"/><TextBlock Text="Облачная синхронизация отсутствует" Foreground="#54D78A" Margin="0,8"/><TextBlock Text="Данные не покидают компьютер" Foreground="#54D78A"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="О программе" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="MasterDocumentation" FontSize="18" Margin="0,22,0,6"/><TextBlock x:Name="RuntimeText"/><TextBlock x:Name="AppPathText" TextWrapping="Wrap" Margin="0,8"/><Button Content="Открыть папку журналов" Click="OpenLogs_Click" Margin="0,14,0,0"/></StackPanel></ScrollViewer>
   </Grid></Border>
   <StackPanel Grid.Column="4">
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10"><StackPanel><TextBlock Text="🛡   Ваши данные остаются на вашем компьютере" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="MasterDocumentation — локальное приложение. Мы не храним ваши файлы и не передаём их в облако." Foreground="#98A3B2" TextWrapping="Wrap" Margin="0,10,0,16"/><TextBlock Text="◉  100% локально" Margin="0,5"/><TextBlock Text="♧  Без облачной синхронизации" Margin="0,5"/><TextBlock Text="⊘  Без сбора телеметрии" Margin="0,5"/><Button Content="▣  Открыть папку данных" HorizontalAlignment="Stretch" Click="OpenData_Click" Margin="0,13,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="Текущее хранилище" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="StoragePathText" TextWrapping="Wrap" Foreground="#AAB4C2" Margin="0,12,0,8"/><TextBlock x:Name="StorageStatsText" TextWrapping="Wrap" Foreground="#AAB4C2"/><ProgressBar x:Name="DiskUsageBar" Height="10" Margin="0,12,0,0" Maximum="100"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Быстрое резервное копирование" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Создайте резервную копию всех данных." Foreground="#AAB4C2" TextWrapping="Wrap" Margin="0,10"/><Button Content="⇧  Создать резервную копию" Click="QuickBackup_Click"/><TextBlock x:Name="LastBackupText" Foreground="#929EAE" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2"><Button Content="↻  Сбросить настройки" HorizontalAlignment="Left" Width="205" Click="Reset_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveButton" Content="✓  Сохранить" Width="145" Background="#6E52B5" Click="Save_Click" IsEnabled="False"/><Button Content="×  Отмена" Width="125" Click="Cancel_Click"/></StackPanel></Grid>
 </Grid>
</Window>
