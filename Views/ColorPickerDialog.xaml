<Window x:Class="MasterDocumentation.Views.ColorPickerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Выбор цвета" Width="590" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Caption" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Canvas x:Name="Palette" Width="360" Height="240" Cursor="Cross" MouseLeftButtonDown="Palette_Mouse" MouseMove="Palette_Mouse">
    <Rectangle x:Name="HueSurface" Width="360" Height="240" Fill="Red"/><Rectangle Width="360" Height="240"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Rectangle Width="360" Height="240"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Ellipse x:Name="PaletteMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" IsHitTestVisible="False"><Ellipse.Effect><DropShadowEffect BlurRadius="3"/></Ellipse.Effect></Ellipse>
   </Canvas>
   <StackPanel Grid.Column="2"><Border x:Name="Preview" Height="74" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14"/><TextBlock Text="HEX" Opacity=".7"/><TextBox x:Name="HexBox" Height="30" Margin="0,3,0,10" TextChanged="Hex_TextChanged"/><TextBlock Text="RGB" Opacity=".7"/><UniformGrid Columns="3" Margin="0,3,0,0"><TextBox x:Name="RBox" Margin="0,0,4,0" TextChanged="Rgb_TextChanged"/><TextBox x:Name="GBox" Margin="2,0" TextChanged="Rgb_TextChanged"/><TextBox x:Name="BBox" Margin="4,0,0,0" TextChanged="Rgb_TextChanged"/></UniformGrid><Button x:Name="NoColorButton" Content="Без цвета" Margin="0,18,0,0" Click="NoColor_Click"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14"><Rectangle Height="24" RadiusX="4" RadiusY="4" MouseLeftButtonDown="Hue_Mouse" MouseMove="Hue_Mouse"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFF0000" Offset="0"/><GradientStop Color="#FFFFFF00" Offset=".167"/><GradientStop Color="#FF00FF00" Offset=".333"/><GradientStop Color="#FF00FFFF" Offset=".5"/><GradientStop Color="#FF0000FF" Offset=".667"/><GradientStop Color="#FFFF00FF" Offset=".833"/><GradientStop Color="#FFFF0000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border x:Name="HueMarker" Width="8" Height="32" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Left" IsHitTestVisible="False"/></Grid>
  <StackPanel Grid.Row="3"><TextBlock Text="Готовые цвета" FontWeight="SemiBold" Margin="0,0,0,8"/><UniformGrid x:Name="Swatches" Columns="12" Rows="2"/></StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Width="90" IsCancel="True"/><Button Content="Выбрать" Width="100" IsDefault="True" Click="Ok_Click"/></StackPanel>
 </Grid>
</Window>
