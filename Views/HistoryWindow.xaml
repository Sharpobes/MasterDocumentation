<Window x:Class="MasterDocumentation.Views.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="История версий" Width="1080" Height="620" MinWidth="820" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="История версий документа" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Закреплённые версии не удаляются автоматической ротацией. Содержимое выбранной версии сравнивается с текущим документом." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,14"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="VersionsList" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="VersionsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Padding="9" Margin="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="★" Foreground="#E7C05E" Visibility="{Binding IsPinned,Converter={StaticResource BooleanToVisibilityConverter}}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding CreatedAt,StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Size,StringFormat={}{0:N0} Б}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Выбранная версия" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Padding="0"/></Grid></Border><Border Grid.Column="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Текущая версия" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="CurrentText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Padding="0"/></Grid></Border></Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button Content="★ Закрепить / открепить" Click="TogglePin_Click"/><Button Content="Удалить версию" Foreground="#F08A8A" Click="DeleteVersion_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Закрыть" IsCancel="True"/><Button Content="Восстановить выбранную" Click="Restore_Click" Background="#6E52B5" Foreground="White"/></StackPanel></Grid>
 </Grid>
</Window>
