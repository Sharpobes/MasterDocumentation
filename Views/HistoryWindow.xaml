<Window x:Class="MasterDocumentation.Views.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="История версий" Width="620" Height="500" WindowStartupLocation="CenterOwner" Background="#171F29" Foreground="#D7DCE5">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="История версий документа" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/><ListBox x:Name="VersionsList" Grid.Row="1" Background="#111820" Foreground="#D7DCE5" BorderBrush="#303B49"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CreatedAt,StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}" Foreground="#929EAE"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Size,StringFormat={}{0:N0} байт}" Foreground="#929EAE" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Закрыть" IsCancel="True"/><Button Content="Восстановить выбранную" Click="Restore_Click" Background="#6E52B5" Foreground="White"/></StackPanel></Grid>
</Window>
