<Window x:Class="MasterDocumentation.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:m="clr-namespace:MasterDocumentation.Models;assembly=MasterDocumentation.Core" xmlns:editor="clr-namespace:MasterDocumentation.Editor;assembly=MasterDocumentation.Editor" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="MasterDocumentation" Width="1536" Height="1024" MinWidth="1180" MinHeight="720" WindowStyle="None" Background="#111820" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/><CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed"/></Window.CommandBindings>
 <Window.Resources>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#BCC5D3"/><Setter Property="FontSize" Value="17"/></Style>
  <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#BCC5D3"/><Setter Property="FontSize" Value="16"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#C5CBD6"/><Setter Property="Margin" Value="8,1"/><Setter Property="Padding" Value="11,7"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style x:Key="PanelBorder" TargetType="Border"><Setter Property="Background" Value="#171F29"/><Setter Property="BorderBrush" Value="#2A3442"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#20242A"/><Setter Property="Background" Value="#F4F6F8"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <!-- Верхняя строка приложения -->
  <Border Grid.Row="0" Background="#111820" BorderBrush="#27313E" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"><Border Width="20" Height="20" CornerRadius="4" Background="#7557BD"><TextBlock Text="▥" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Text="MasterDocumentation" Foreground="#E8ECF3" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/><Button Style="{StaticResource IconButton}" Content="☰" FontSize="15" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button.ContextMenu><ContextMenu><MenuItem Header="Создать документ" Click="NewDocument_Click"/><MenuItem Header="Создать папку" Click="NewFolder_Click"/><Separator/><MenuItem Header="Сохранить" Command="ApplicationCommands.Save"/><MenuItem Header="Резервная копия" Click="Backup_Click"/><MenuItem Header="Восстановить" Click="Restore_Click"/><MenuItem Header="Экспорт" Click="Export_Click"/><Separator/><MenuItem Header="Тёмная тема" IsCheckable="True" IsChecked="{Binding DarkTheme}"/><MenuItem Header="О программе" Click="About_Click"/><MenuItem Header="Выход" Click="Exit_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel>
    <Border Grid.Column="1" Background="#202839" CornerRadius="4" Margin="8,8,4,8" Padding="10,0"><DockPanel><TextBlock Text="›  ▣" Foreground="#8E7BD7" VerticalAlignment="Center"/><TextBlock Text="{Binding SelectedTab.Title, FallbackValue=Новая вкладка}" Foreground="#E3E7EF" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="●" Foreground="#9B7CE8" FontSize="9" VerticalAlignment="Center" DockPanel.Dock="Right"/></DockPanel></Border>
    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="＋" HorizontalAlignment="Left" VerticalAlignment="Center" Click="NewDocument_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Width="202" Height="34" Background="#151D26" BorderBrush="#303A47" BorderThickness="1" CornerRadius="4" Margin="0,0,18,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"><DockPanel><TextBlock Text="⌕" Foreground="#8995A6" FontSize="19" Margin="9,0,5,0" VerticalAlignment="Center"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#AEB7C5" Padding="0" VerticalContentAlignment="Center" ToolTip="Поиск (Ctrl+K)"/></DockPanel></Border><Button Style="{StaticResource IconButton}" Content="◇" ToolTip="Теги"/><Button Style="{StaticResource IconButton}" Content="?" ToolTip="Справка" Click="About_Click"/></StackPanel>
    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click"/><Button Style="{StaticResource IconButton}" Content="□" Click="Maximize_Click"/><Button Style="{StaticResource IconButton}" Content="×" FontSize="22" Click="Exit_Click"/></StackPanel>
   </Grid>
  </Border>
  <TabControl x:Name="Tabs" Grid.Row="0" Visibility="Collapsed" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" SelectionChanged="Tabs_SelectionChanged"/>
  <!-- Основная рабочая область -->
  <Grid Grid.Row="1" Margin="5,5,5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="6"/><ColumnDefinition Width="225"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
   <!-- Левая навигация -->
   <Border Grid.Column="0" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button Grid.Row="0" Content="＋  Создать" Height="36" Margin="8" Background="#6E52B5" BorderBrush="#7E61C8" Foreground="White" Click="NewDocument_Click"/>
    <StackPanel Grid.Row="1" Margin="0,2,0,8"><Button Style="{StaticResource NavButton}" Click="AllDocuments_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▧   Все документы"/><TextBlock x:Name="AllDocumentsCountText" Grid.Column="1" Foreground="#929EAE" Margin="12,0,0,0"/></Grid></Button><Button Style="{StaticResource NavButton}" Click="Favorites_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="☆   Избранное"/><TextBlock x:Name="FavoritesCountText" Grid.Column="1" Foreground="#929EAE" Margin="12,0,0,0"/></Grid></Button><Button Style="{StaticResource NavButton}" Click="Recent_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="◷   Недавние"/><TextBlock x:Name="RecentDocumentsCountText" Grid.Column="1" Foreground="#929EAE" Margin="12,0,0,0"/></Grid></Button><Button Style="{StaticResource NavButton}" Click="Trash_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="♲   Корзина"/><TextBlock x:Name="TrashCountText" Grid.Column="1" Foreground="#929EAE" Margin="12,0,0,0"/></Grid></Button><Separator/><DockPanel Margin="14,8,14,5"><TextBlock Text="РАЗДЕЛЫ" Foreground="#AEB6C4" FontSize="12" FontWeight="SemiBold"/><Button Content="＋" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" DockPanel.Dock="Right" Click="NewFolder_Click"/></DockPanel></StackPanel>
    <TreeView Grid.Row="2" x:Name="Tree" ItemsSource="{Binding Nodes}" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_DoubleClick" AllowDrop="True" PreviewMouseMove="Tree_MouseMove" Drop="Tree_Drop" Background="Transparent" BorderThickness="0" Foreground="#C8CED8" Margin="8,0">
     <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type m:NodeItem}" ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding IsFolder, Converter={StaticResource NodeIconConverter}}" Margin="0,0,7,0"/><TextBlock Text="{Binding Title}"/></StackPanel></HierarchicalDataTemplate></TreeView.Resources>
     <TreeView.ContextMenu><ContextMenu><MenuItem Header="Открыть" Click="OpenNode_Click"/><MenuItem Header="В избранное / убрать" Click="FavoriteNode_Click"/><MenuItem Header="Использовать как шаблон" Click="MakeTemplate_Click"/><MenuItem Header="Переименовать" Click="Rename_Click"/><MenuItem Header="Восстановить из корзины" Click="RestoreNode_Click"/><MenuItem Header="Переместить в корзину" Click="Delete_Click"/></ContextMenu></TreeView.ContextMenu>
    </TreeView>
    <StackPanel Grid.Row="3" Margin="8,5"><Button Style="{StaticResource NavButton}" Content="▣   Шаблоны" Click="Templates_Click"/><Button Style="{StaticResource NavButton}" Content="▦   Приложения" Click="Applications_Click"/></StackPanel>
    <Grid Grid.Row="4" Background="#1A232E"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="42"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="15,7"><Border Width="24" Height="24" Background="#174B35" CornerRadius="12"><TextBlock Text="▤" Foreground="#42CE83" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="Локальное хранилище" Foreground="#9FA9B8" FontSize="11"/><TextBlock Text="E:\MasterDocumentation" Foreground="#788495" FontSize="10"/></StackPanel><TextBlock Text="●" Foreground="#3BD97D" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><UniformGrid Grid.Row="1" Columns="4"><Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="Настройки" Click="Settings_Click"/><Button Style="{StaticResource IconButton}" Content="◉"/><Button Style="{StaticResource IconButton}" Content="☾"/><Button Style="{StaticResource IconButton}" Content="▣"/></UniformGrid></Grid>
   </Grid></Border>
   <!-- Структура документа -->
   <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Структура" Foreground="#E0E5ED" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Заголовки" Foreground="#9DA7B6" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Height="2" Background="#8B63D3" VerticalAlignment="Bottom"/></Grid><ListBox x:Name="StructureList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#B9C1CD" Margin="8" MouseDoubleClick="Heading_DoubleClick"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Padding="7,5" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
   <!-- Редактор -->
   <Border Grid.Column="4" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Content="↶" Tag="undo" Click="ModernCommand_Click"/><Button Style="{StaticResource IconButton}" Content="↷" Tag="redo" Click="ModernCommand_Click"/></StackPanel></Grid>
    <Border Grid.Row="1" BorderBrush="#2A3442" BorderThickness="0,1"><DockPanel Margin="10,3"><ComboBox x:Name="HeadingBox" Width="125" Background="Transparent" Foreground="#D7DCE5" BorderThickness="0" SelectionChanged="Heading_Changed"><ComboBoxItem Content="Обычный" IsSelected="True" Tag="0"/><ComboBoxItem Content="Заголовок 1" Tag="1"/><ComboBoxItem Content="Заголовок 2" Tag="2"/><ComboBoxItem Content="Заголовок 3" Tag="3"/></ComboBox><Separator/><ToggleButton Style="{StaticResource IconToggle}" Content="B" FontWeight="Bold" Tag="bold" Click="ModernCommand_Click"/><ToggleButton Style="{StaticResource IconToggle}" Content="I" FontStyle="Italic" Tag="italic" Click="ModernCommand_Click"/><ToggleButton Style="{StaticResource IconToggle}" Content="U" Tag="underline" Click="ModernCommand_Click"/><Button Style="{StaticResource IconButton}" Content="S̶" Tag="strike" Click="ModernCommand_Click"/><Button Style="{StaticResource IconButton}" Content="A̲" Click="TextColor_Click"/><Button Style="{StaticResource IconButton}" Content="✎" Foreground="#E9D45D" Click="BackColor_Click"/><Button Style="{StaticResource IconButton}" Content="≡" Tag="alignLeft" Click="ModernCommand_Click"/><Button Style="{StaticResource IconButton}" Content="•≡" Tag="bulletList" Click="ModernCommand_Click"/><Button Style="{StaticResource IconButton}" Content="1≡" Tag="orderedList" Click="ModernCommand_Click"/><Button Style="{StaticResource IconButton}" Content="⌁" Click="Link_Click"/><Button Style="{StaticResource IconButton}" Content="▧" Click="Image_Click"/><Button Style="{StaticResource IconButton}" Content="▦" Click="Table_Click"/><Button Style="{StaticResource IconButton}" Content="&lt;/&gt;" Tag="code" Click="ModernCommand_Click"/><Button Style="{StaticResource IconButton}" Content="❞" Tag="blockquote" Click="ModernCommand_Click"/><ToggleButton x:Name="AdvancedToggle" Style="{StaticResource IconToggle}" Content="…"/>
     <Popup IsOpen="{Binding IsChecked,ElementName=AdvancedToggle}" PlacementTarget="{Binding ElementName=AdvancedToggle}" Placement="Bottom" StaysOpen="False"><Border Background="#222C38" BorderBrush="#3A4656" BorderThickness="1" CornerRadius="6" Padding="6"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Content="⌨" ToolTip="Блок кода" Click="CodeBlock_Click"/><Button Style="{StaticResource IconButton}" Content="◉" ToolTip="Спойлер" Click="Spoiler_Click"/><Button Style="{StaticResource IconButton}" Content="X₂" Click="Subscript_Click"/><Button Style="{StaticResource IconButton}" Content="X²" Click="Superscript_Click"/><Button Style="{StaticResource IconButton}" Content="Aa" Click="ChangeCase_Click"/><Button Style="{StaticResource IconButton}" Content="⌫" Click="ClearFormatting_Click"/><ComboBox Width="70" SelectedIndex="0" SelectionChanged="LineSpacing_Changed"><ComboBoxItem Content="1,0" Tag="1"/><ComboBoxItem Content="1,5" Tag="1.5"/><ComboBoxItem Content="2,0" Tag="2"/></ComboBox><ComboBox x:Name="FontFamilyBox" Width="130" SelectionChanged="FontFamily_Changed"/><ComboBox x:Name="FontSizeBox" Width="58" IsEditable="True" SelectionChanged="FontSize_Changed" LostKeyboardFocus="FontSize_LostFocus"/></StackPanel></Border></Popup>
    </DockPanel></Border>
    <Grid Grid.Row="2"><TextBlock x:Name="EmptyHint" Text="Выберите или создайте документ" Foreground="#7F8A9A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/><editor:TiptapEditor x:Name="ModernEditor" Visibility="Collapsed" ContentChanged="ModernEditor_ContentChanged"/><RichTextBox x:Name="Editor" Visibility="Collapsed" AcceptsTab="True" Padding="38,22" BorderThickness="0" Background="#171F29" Foreground="#D6DBE4" FontSize="15" CaretBrush="#F2F4F8" VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" PreviewKeyDown="Editor_PreviewKeyDown" PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown" SpellCheck.IsEnabled="True"/></Grid>
   </Grid></Border>
   <!-- Свойства -->
   <Border Grid.Column="6" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="300"/><RowDefinition Height="*"/><RowDefinition Height="265"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Свойства" Foreground="#E2E7EE" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="AttachmentsHeaderText" Grid.Column="1" Text="Вложения (0)" Foreground="#A3ADBB" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Height="2" Background="#8B63D3" VerticalAlignment="Bottom"/></Grid>
    <Grid Grid.Row="1" Margin="14,15"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="48"/><RowDefinition Height="52"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="Тип документа" Foreground="#9BA6B5" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Документ" Foreground="#D0D5DE" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="Статус" Foreground="#9BA6B5" VerticalAlignment="Center"/><ComboBox x:Name="StatusBox" Grid.Row="1" Grid.Column="1" SelectionChanged="Status_Changed"><ComboBoxItem Content="Черновик"/><ComboBoxItem Content="В работе"/><ComboBoxItem Content="На проверке"/><ComboBoxItem Content="Завершён"/><ComboBoxItem Content="Архив"/></ComboBox><TextBlock Grid.Row="2" Text="Теги" Foreground="#9BA6B5" VerticalAlignment="Center"/><Button x:Name="TagsButton" Grid.Row="2" Grid.Column="1" Content="＋ Добавить" Click="Tags_Click"/><TextBlock Grid.Row="3" Text="Создан" Foreground="#9BA6B5" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTab.CreatedAt,StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#B7C0CD" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Text="Изменён" Foreground="#9BA6B5" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTab.ModifiedAt,StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#B7C0CD" VerticalAlignment="Center"/><TextBlock Grid.Row="5" Text="Автор" Foreground="#9BA6B5" VerticalAlignment="Center"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Локальный пользователь" Foreground="#B7C0CD" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="2" BorderBrush="#2A3442" BorderThickness="0,1"><DockPanel Margin="14,18"><TextBlock DockPanel.Dock="Top" Text="ОГЛАВЛЕНИЕ" Foreground="#AEB7C4" FontSize="12" Margin="0,0,0,12"/><ListBox x:Name="TocList" Background="Transparent" BorderThickness="0" Foreground="#929EAE" MouseDoubleClick="Heading_DoubleClick"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Padding="5" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <Border Grid.Row="3" BorderBrush="#2A3442" BorderThickness="0,1,0,0"><StackPanel Margin="14,16"><TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="#AEB7C4" FontSize="12" Margin="0,0,0,11"/><Button Style="{StaticResource NavButton}" Background="#252E3A" Content="⇧   Экспорт документа" Click="ExportDocument_Click"/><Button Style="{StaticResource NavButton}" Background="#252E3A" Content="▣   Печать" Click="Print_Click"/><Button Style="{StaticResource NavButton}" Background="#252E3A" Content="▤   Создать копию" Click="Duplicate_Click"/><Button Style="{StaticResource NavButton}" Background="#252E3A" Content="◴   История версий" Click="History_Click"/><Separator/><StackPanel Orientation="Horizontal"><Button Content="− Уменьшить" Click="ImageSmaller_Click"/><Button Content="＋ Увеличить" Click="ImageLarger_Click"/></StackPanel></StackPanel></Border>
   </Grid></Border>
  </Grid>
  <!-- Строка состояния -->
  <Border Grid.Row="2" Background="#111820" BorderBrush="#27313E" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock x:Name="DocumentStatsText" Text="Слов: 0   Символов: 0" Foreground="#8E99A8"/><TextBlock Text="{Binding SelectedTab.ModifiedAt,StringFormat=Изменено: {0:dd.MM.yyyy HH:mm}}" Foreground="#8E99A8" Margin="48,0,20,0"/><Separator/><Button Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Content="−"/><TextBlock Text="100%" Foreground="#AEB7C4" Margin="9,0"/><Button Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Content="＋"/></StackPanel></Border>
 </Grid>
</Window>
