<UserControl x:Class="MasterDocumentation.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ElevatedPanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="Padding" Value="16,11"/><Setter Property="BorderBrush" Value="#2A3542"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="56"/><Setter Property="Margin" Value="5,2"/><Setter Property="Padding" Value="10,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="42" Height="22"><Border x:Name="Track" Background="#2B3643" BorderBrush="#455263" BorderThickness="1" CornerRadius="11"/><Ellipse x:Name="Knob" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" Fill="#D6DCE5"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#7653D2"/><Setter TargetName="Track" Property="BorderBrush" Value="#936FEB"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="9"/><Setter Property="Background" Value="#283340"/><Setter Property="Foreground" Value="#8B63D3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" CornerRadius="5"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5" HorizontalAlignment="Left"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid Margin="5,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="5,4">
    <Button Style="{StaticResource Nav}" Click="General_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⚙" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Общие" FontSize="15"/><TextBlock Text="Язык, запуск, недавние файлы" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
    <Button Style="{StaticResource Nav}" Click="Storage_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="▣" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Хранение" FontSize="15"/><TextBlock Text="Пути, база данных, копии" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
    <Button Style="{StaticResource Nav}" Click="EditorSettings_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="✎" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Редактор" FontSize="15"/><TextBlock Text="Шрифты, сохранение, проверка" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
    <Button Style="{StaticResource Nav}" Click="Interface_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="▤" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Интерфейс" FontSize="15"/><TextBlock Text="Тема и плотность элементов" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
    <Button Style="{StaticResource Nav}" Click="Documents_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="▧" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Документы и экспорт" FontSize="15"/><TextBlock Text="Экспорт, изображения, версии" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
    <Button Style="{StaticResource Nav}" Click="Hotkeys_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⌨" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Горячие клавиши" FontSize="15"/><TextBlock Text="Сочетания клавиш" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
    <Button Style="{StaticResource Nav}" Click="Security_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="◇" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Безопасность" FontSize="15"/><TextBlock Text="Данные и шифрование" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
    <Button Style="{StaticResource Nav}" Click="About_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="ⓘ" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="О программе" FontSize="15"/><TextBlock Text="Версия и журналы" FontSize="11" Foreground="#8895A6"/></StackPanel></Grid></Button>
   </StackPanel></ScrollViewer>
   <Button Grid.Row="2" Content="↻  Сбросить настройки" Margin="12" HorizontalContentAlignment="Center" Click="Reset_Click"/>
  </Grid></Border>

  <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
   <Grid Margin="20,0"><TextBlock x:Name="SectionTitle" Text="Общие" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" Width="32" Height="32" MinHeight="32" HorizontalAlignment="Right" ToolTip="Закрыть настройки" Click="Cancel_Click"/></Grid>
   <Grid Grid.Row="1" Margin="20,0,20,4">
    <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◎  Язык интерфейса"/><TextBlock Text="Язык меню и системных сообщений" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="Control_Changed"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◷  Поведение при запуске"/><TextBlock Text="Что открывать после запуска" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><ComboBox x:Name="StartupBox" Grid.Column="1" SelectionChanged="Control_Changed"><ComboBoxItem Content="Открывать последнюю сессию"/><ComboBoxItem Content="Открывать стартовую страницу"/><ComboBoxItem Content="Открывать пустое окно"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◷  Количество недавних файлов"/><TextBlock Text="От 1 до 100 документов" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="−" Click="RecentMinus_Click"/><TextBlock x:Name="RecentCountText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" Content="＋" Click="RecentPlus_Click"/></Grid></Grid></Border>
      <Border Padding="16,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◉  Компактный режим"/><TextBlock Text="Уменьшает внутренние отступы" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><CheckBox x:Name="CompactCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
     </StackPanel></Border>
     <TextBlock Text="Дополнительно" FontWeight="SemiBold" Margin="2,4,0,10"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◉  Проверять обновления автоматически"/><TextBlock Text="Только уведомление о новых версиях" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><CheckBox x:Name="UpdatesCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="☏  Показывать подсказки"/><TextBlock Text="Контекстные подсказки в интерфейсе" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><CheckBox x:Name="TooltipsCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◇  Подтверждать удаление документов"/><TextBlock Text="Показывать диалог подтверждения" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><CheckBox x:Name="ConfirmDeleteCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="Control_Changed" Unchecked="Control_Changed"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="◎  Открывать ссылки во" VerticalAlignment="Center"/><ComboBox x:Name="LinkBox" Grid.Column="1" SelectionChanged="Control_Changed"><ComboBoxItem Content="Во встроенном браузере"/><ComboBoxItem Content="В системном браузере"/></ComboBox></Grid></Border>
      <Border Padding="16,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="◉  Единицы измерения" VerticalAlignment="Center"/><ComboBox x:Name="UnitsBox" Grid.Column="1" SelectionChanged="Control_Changed"><ComboBoxItem Content="Миллиметры (мм)"/><ComboBoxItem Content="Дюймы"/><ComboBoxItem Content="Пиксели"/></ComboBox></Grid></Border>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="StoragePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Папка данных" Foreground="{DynamicResource MutedTextBrush}"/><TextBox x:Name="DataPathBox" IsReadOnly="True" Margin="0,7,0,10"/><WrapPanel><Button Content="Изменить папку…" Click="ChangeDataPath_Click"/><Button Content="Открыть папку" Click="OpenData_Click"/><Button Content="Проверить базу" Click="CheckDatabase_Click"/></WrapPanel><TextBlock Text="При переносе данные сначала копируются во временную папку и проверяются. Старое хранилище не удаляется автоматически." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="Обслуживание" Foreground="{DynamicResource MutedTextBrush}" Margin="0,22,0,6"/><WrapPanel><Button Content="Перестроить поисковый индекс" Click="RebuildIndex_Click"/><Button Content="Очистить неиспользуемые файлы" Click="CleanupAssets_Click"/></WrapPanel><TextBlock Text="Папка вложений" Foreground="{DynamicResource MutedTextBrush}" Margin="0,22,0,5"/><TextBlock x:Name="AssetsPathText" TextWrapping="Wrap"/><TextBlock Text="Резервные копии" Foreground="{DynamicResource MutedTextBrush}" Margin="0,22,0,5"/><TextBlock x:Name="BackupsPathText" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Шрифт по умолчанию" Margin="0,0,0,6"/><ComboBox x:Name="DefaultFontBox" SelectionChanged="Control_Changed"/><TextBlock Text="Размер шрифта" Margin="0,18,0,6"/><TextBox x:Name="DefaultFontSizeBox" TextChanged="Control_Changed"/><CheckBox x:Name="SpellCheckBox" Content="Проверка орфографии" Margin="0,18" Checked="Control_Changed" Unchecked="Control_Changed"/><TextBlock Text="Задержка автосохранения, секунд"/><TextBox x:Name="AutoSaveDelayBox" Margin="0,6,0,0" TextChanged="Control_Changed"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="InterfacePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Тема приложения" Margin="0,0,0,6"/><ComboBox x:Name="ThemeBox" SelectionChanged="Control_Changed"><ComboBoxItem Content="Системная"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/></ComboBox><TextBlock Text="Изменение темы применяется после сохранения." Foreground="{DynamicResource MutedTextBrush}" Margin="0,10"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="DocumentsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Папка экспорта" Margin="0,0,0,6"/><TextBlock x:Name="ExportsPathText" TextWrapping="Wrap"/><Button Content="Открыть папку экспорта" HorizontalAlignment="Left" Margin="0,12" Click="OpenExports_Click"/><TextBlock Text="Форматы экспорта: PDF, DOCX, HTML, Markdown и обычный текст." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <Grid x:Name="HotkeysPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="HotkeysGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource ElevatedPanelBrush}" CellEditEnding="HotkeysGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="Команда" Binding="{Binding Command}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Сочетание" Binding="{Binding Gesture,UpdateSourceTrigger=PropertyChanged}" Width="145"/><DataGridTextColumn Header="Категория" Binding="{Binding Category}" IsReadOnly="True" Width="130"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="Сбросить сочетания" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetHotkeys_Click"/></Grid>
    <ScrollViewer x:Name="SecurityPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><CheckBox x:Name="EncryptionCheck" Content="Шифровать ручные резервные копии AES-256-GCM" Checked="Control_Changed" Unchecked="Control_Changed"/><TextBlock Text="Пароль запрашивается при создании каждой копии и нигде не сохраняется." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,24"/><TextBlock Text="✓ Телеметрия отсутствует" Foreground="#54D78A"/><TextBlock Text="✓ Облачная синхронизация отсутствует" Foreground="#54D78A" Margin="0,9"/><TextBlock Text="✓ Данные не покидают компьютер" Foreground="#54D78A"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="MasterDocumentation" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeText" Margin="0,18,0,6"/><TextBlock x:Name="AppPathText" TextWrapping="Wrap"/><Button Content="Открыть папку журналов" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenLogs_Click"/></StackPanel></ScrollViewer>
   </Grid>
   <Grid Grid.Row="2" Margin="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveButton" Content="✓  Сохранить" Width="145" Background="#6E52B5" Foreground="White" Click="Save_Click"/><Button Content="×  Отмена" Width="120" Click="Cancel_Click"/></StackPanel></Grid>
  </Grid></Border>

  <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="◇  Ваши данные остаются на вашем компьютере" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="MasterDocumentation — локальное приложение. Файлы не передаются в облако." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/><TextBlock Text="◉  100% локально"/><TextBlock Text="♧  Без облачной синхронизации" Margin="0,10"/><TextBlock Text="⊘  Без сбора телеметрии"/><Button Content="▱  Открыть папку данных" Margin="0,18,0,0" Click="OpenData_Click"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Текущее хранилище" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="StoragePathText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock x:Name="StorageStatsText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="DiskUsageBar" Margin="0,12,0,0" Maximum="100"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Быстрое резервное копирование" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Создайте резервную копию всех локальных данных." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10"/><Button Content="⇧  Создать резервную копию" Click="QuickBackup_Click"/><TextBlock x:Name="LastBackupText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
