<Window x:Class="MasterDocumentation.Views.NewItemDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Создание" Width="500" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources><Style TargetType="TextBox"><Setter Property="Background" Value="#242E3A"/><Setter Property="Foreground" Value="#E0E5EC"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="10,7"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Background" Value="{DynamicResource ElevatedPanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="8,5"/></Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#252F3C"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="HeadingText" Text="Создать документ" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Grid.Row="1" Text="Название" Foreground="#9DA8B7"/><TextBox x:Name="TitleBox" Grid.Row="2" Height="38" Margin="0,6,0,14"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Тип" Foreground="#9DA8B7"/><Border Margin="0,6,0,0" Height="36" Background="{DynamicResource ElevatedPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,0"><TextBlock x:Name="KindText" VerticalAlignment="Center"/></Border></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Расположение" Foreground="#9DA8B7"/><ComboBox x:Name="ParentBox" Margin="0,6,0,0" DisplayMemberPath="Name"/></StackPanel></Grid><StackPanel x:Name="TemplatePanel" Grid.Row="4" Margin="0,16,0,0"><TextBlock Text="Создать из шаблона" Foreground="#9DA8B7"/><ComboBox x:Name="TemplateBox" Margin="0,6,0,0" DisplayMemberPath="Title"/><TextBlock Text="Шаблон копирует содержимое и форматирование, но создаёт независимый документ." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True"/><Button Content="Создать" Background="#6E52B5" Foreground="White" IsDefault="True" Click="Create_Click"/></StackPanel></Grid>
</Window>
